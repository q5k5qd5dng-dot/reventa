PORT=8787
PUBLIC_URL=http://localhost:8787
NODE_ENV=development
# Producción: clave larga y aleatoria para cifrar IBAN (obligatoria)
DATA_KEY=
DATA_DIR=data
SESSION_DAYS=30
# Pagos reales (opcional). Sin esto se usa el modo "mock".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Emails (opcional). Sin esto se imprimen en consola.
RESEND_API_KEY=
MAIL_FROM="Handticket <no-reply@handticket.es>"
# Dominio del front, separados por comas, si se sirve desde otro origen
ALLOWED_ORIGINS=
