---
import { events, poster } from "../data/events";
---

<section id="v-login" class="view" data-view="login">
  <div class="grid min-h-screen lg:grid-cols-2">
    <!-- Panel visual -->
    <div class="relative isolate hidden overflow-hidden lg:block">
      <div class="aurora -left-20 top-0 h-[28rem] w-[28rem] bg-violet"></div><div class="aurora bottom-0 right-0 h-[26rem] w-[26rem] bg-pink/70"></div><div class="aurora left-1/3 top-1/2 h-72 w-72 bg-cyan/50"></div>
      <div class="dotgrid absolute inset-0 opacity-40"></div>
      <div class="relative flex h-full flex-col justify-between p-14 pt-32">
        <div class="ticket3d grid place-items-center" id="auth-ticket"><div class="card" id="auth-card"><div class="holo"></div>
          <div class="poster h-[48%] w-full" set:html={poster(events[4], 300)}></div>
          <div class="px-6 pt-5"><p class="text-[10px] font-bold uppercase tracking-[0.3em] text-lime">Tu próxima noche</p><p class="mt-2 font-display text-2xl font-semibold leading-tight">Noche Techno</p><p class="text-sm text-white/60">Sala Apolo · Barcelona</p></div>
          <div class="absolute inset-x-6 bottom-6 flex items-end justify-between"><div class="qr w-20 rounded-lg bg-white/95 p-1.5" data-qr="auth"></div><p class="font-display text-3xl font-bold">18<span class="text-lime">€</span></p></div></div></div>
        <blockquote class="mt-10 max-w-md"><p class="text-xl font-semibold leading-snug">“Entré a un evento agotado sin ningún problema. Es la primera reventa en la que confío.”</p><p class="mt-3 text-sm text-mute">— Iván, comprador verificado</p></blockquote>
      </div>
    </div>

    <!-- Formularios -->
    <div class="relative flex items-center justify-center px-5 pb-16 pt-32 lg:pt-20">
      <div class="w-full max-w-md" id="auth-wrap">
        <div class="glass relative mb-8 grid grid-cols-2 rounded-full p-1.5 text-sm font-bold" role="tablist" id="auth-tabs">
          <i id="auth-pill" class="absolute inset-y-1.5 left-1.5 w-[calc(50%-0.375rem)] rounded-full bg-lime"></i>
          <button type="button" role="tab" data-auth="login" class="relative z-10 rounded-full py-3 text-black">Iniciar sesión</button>
          <button type="button" role="tab" data-auth="register" class="relative z-10 rounded-full py-3 text-white/70">Crear cuenta</button>
        </div>

        <div class="relative">
          <!-- LOGIN -->
          <form id="f-login" data-auth-form="login" novalidate class="space-y-4">
            <h1 class="text-4xl font-bold uppercase leading-none" data-auth-title>Hola de <span class="text-lime">nuevo</span></h1>
            <p class="text-mute">Entra para ver tus entradas y vender las que no uses.</p>
            <div class="grid grid-cols-2 gap-3 pt-2">
              <button type="button" data-social="Google" class="btn btn-ghost !py-3 !text-sm"><svg viewBox="0 0 24 24" class="h-5 w-5"><path fill="#fff" d="M21.800 12.200c0-.7-.1-1.300-.2-1.900H12v3.600h5.500a4.700 4.700 0 01-2 3.100v2.500h3.300c1.900-1.800 3-4.400 3-7.300z" opacity=".9"/><path fill="#fff" d="M12 22c2.700 0 5-.9 6.700-2.400l-3.300-2.500c-.9.600-2 1-3.400 1-2.600 0-4.800-1.800-5.600-4.100H3v2.600A10 10 0 0012 22z" opacity=".7"/><path fill="#fff" d="M6.400 14c-.2-.6-.3-1.300-.3-2s.1-1.400.3-2V7.400H3a10 10 0 000 9.200L6.400 14z" opacity=".5"/><path fill="#fff" d="M12 5.900c1.500 0 2.800.5 3.800 1.500l2.900-2.900A10 10 0 003 7.400L6.400 10c.8-2.300 3-4.100 5.600-4.100z" opacity=".8"/></svg>Google</button>
              <button type="button" data-social="Apple" class="btn btn-ghost !py-3 !text-sm"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor"><path d="M16.400 12.600c0-2.400 2-3.500 2.100-3.600-1.100-1.700-2.900-1.900-3.500-1.900-1.500-.2-2.900.9-3.700.9s-1.900-.9-3.200-.8c-1.600 0-3.100 1-4 2.400-1.700 3-.4 7.400 1.200 9.800.8 1.200 1.800 2.500 3 2.400 1.200 0 1.700-.8 3.100-.8s1.900.8 3.200.8c1.300 0 2.100-1.200 2.900-2.300.9-1.300 1.300-2.600 1.300-2.700-.1 0-2.400-.9-2.400-3.800z"/></svg>Apple</button>
            </div>
            <div class="flex items-center gap-3 py-1 text-xs uppercase tracking-widest text-mute"><i class="h-px flex-1 bg-line"></i>o con email<i class="h-px flex-1 bg-line"></i></div>
            <div class="field"><input id="l-email" type="email" placeholder=" " autocomplete="email" required /><label for="l-email">Email</label><p class="msg"></p></div>
            <div class="field"><input id="l-pass" type="password" placeholder=" " autocomplete="current-password" required /><label for="l-pass">Contraseña</label><button type="button" data-eye class="absolute right-3 top-4 text-xs font-bold text-mute hover:text-white">VER</button><p class="msg"></p></div>
            <div class="flex items-center justify-between text-sm"><label class="flex items-center gap-2 text-mute"><input type="checkbox" class="accent-[#c6ff3d]" checked /> Recordarme</label><button type="button" data-forgot class="font-semibold text-lime hover:underline">¿Olvidaste la contraseña?</button></div>
            <button class="btn btn-lime w-full !py-4" data-magnetic>Entrar</button>
          </form>

          <!-- REGISTRO -->
          <form id="f-register" data-auth-form="register" novalidate class="hidden space-y-4">
            <h1 class="text-4xl font-bold uppercase leading-none" data-auth-title>Crea tu <span class="text-lime">cuenta</span></h1>
            <p class="text-mute">Gratis y en 30 segundos. Compra, vende y guarda tus entradas.</p>
            <div class="field"><input id="r-name" type="text" placeholder=" " autocomplete="name" required /><label for="r-name">Nombre</label><p class="msg"></p></div>
            <div class="field"><input id="r-email" type="email" placeholder=" " autocomplete="email" required /><label for="r-email">Email</label><p class="msg"></p></div>
            <div class="field"><input id="r-pass" type="password" placeholder=" " autocomplete="new-password" required /><label for="r-pass">Contraseña (mín. 8)</label><button type="button" data-eye class="absolute right-3 top-4 text-xs font-bold text-mute hover:text-white">VER</button><p class="msg"></p></div>
            <div class="strength flex gap-1.5" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            <label class="flex items-start gap-3 text-sm text-mute"><input id="r-terms" type="checkbox" class="mt-1 accent-[#c6ff3d]" /> Acepto los términos y la política de privacidad.</label>
            <button class="btn btn-lime w-full !py-4" data-magnetic>Crear cuenta</button>
          </form>

          <!-- RECUPERAR -->
          <form id="f-forgot" data-auth-form="forgot" novalidate class="hidden space-y-4">
            <h1 class="text-4xl font-bold uppercase leading-none" data-auth-title>Recupera <span class="text-lime">el acceso</span></h1>
            <p class="text-mute">Te enviamos un enlace para crear una contraseña nueva.</p>
            <div class="field"><input id="f-email" type="email" placeholder=" " required /><label for="f-email">Email</label><p class="msg"></p></div>
            <button class="btn btn-lime w-full !py-4">Enviar enlace</button>
            <button type="button" data-back class="w-full text-sm font-semibold text-mute hover:text-white">← Volver</button>
          </form>
        </div>
        <p class="mt-8 text-center text-xs text-mute">Demostración: tus datos se guardan solo en este navegador.</p>
      </div>
    </div>
  </div>
</section>
