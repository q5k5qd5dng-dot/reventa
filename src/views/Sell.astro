---
import { events } from "../data/events";
---

<section id="v-vender" class="view" data-view="vender">
  <div class="relative isolate overflow-hidden px-5 pb-10 pt-36">
    <div class="aurora -right-20 top-0 h-96 w-96 bg-pink/60"></div><div class="aurora -left-20 top-40 h-80 w-80 bg-violet/60"></div>
    <div class="mx-auto max-w-7xl">
      <p class="text-sm font-bold uppercase tracking-[0.3em] text-lime">Vender</p>
      <h1 class="mt-3 text-[clamp(2.6rem,9vw,8rem)] font-bold uppercase leading-[0.95]" data-split>Vende en <span class="text-outline-lime">minutos</span></h1>
      <p class="mt-5 max-w-xl text-lg text-white/70">Publica gratis. Cobras automáticamente tras el evento. Solo una comisión del 10 % cuando se vende.</p>
    </div>
  </div>
  <div class="mx-auto grid max-w-7xl gap-8 px-5 lg:grid-cols-[1.3fr_1fr]">
    <form id="sell-form" class="glass space-y-6 rounded-[2rem] p-6 sm:p-10" novalidate>
      <div><p class="mb-3 text-xs font-bold uppercase tracking-[0.3em] text-lime">1 · Evento</p>
        <div class="field"><select id="s-ev" class="appearance-none">{events.map((e) => (<option class="bg-bg" value={e.id}>{e.t} — {e.c}</option>))}</select><label for="s-ev">Elige el evento</label></div></div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div><p class="mb-3 text-xs font-bold uppercase tracking-[0.3em] text-lime">2 · Cantidad</p>
          <div class="glass flex items-center justify-between rounded-2xl p-2"><button type="button" data-q="-1" class="grid h-12 w-12 place-items-center rounded-xl bg-white/10 text-2xl hover:bg-white/20" aria-label="Menos">−</button><span class="font-display text-3xl font-bold" id="s-qty">2</span><button type="button" data-q="1" class="grid h-12 w-12 place-items-center rounded-xl bg-white/10 text-2xl hover:bg-white/20" aria-label="Más">+</button></div></div>
        <div><p class="mb-3 text-xs font-bold uppercase tracking-[0.3em] text-lime">3 · Precio por entrada</p>
          <div class="field"><input id="s-price" type="number" min="1" max="999" value="60" placeholder=" " /><label for="s-price">€ por entrada</label></div></div>
      </div>
      <div><input id="s-range" type="range" min="5" max="250" value="60" class="w-full accent-[#c6ff3d]" aria-label="Precio" />
        <p class="mt-2 text-xs text-mute">Precio sugerido para este evento: <b class="text-white" id="s-sug">68 €</b>. Los precios deben respetar la normativa.</p></div>
      <button class="btn btn-lime !px-10 !py-4" data-magnetic>Publicar entradas</button>
    </form>
    <aside class="lg:sticky lg:top-28 lg:self-start">
      <div class="glass relative overflow-hidden rounded-[2rem] p-8">
        <div class="aurora -right-10 -top-10 h-52 w-52 bg-lime/40"></div>
        <p class="relative text-sm text-mute">Cobrarías</p>
        <p class="relative font-display text-6xl font-bold"><span id="s-earn">108</span><span class="text-lime">€</span></p>
        <div class="relative mt-6 space-y-2 border-t border-line pt-5 text-sm text-mute"><div class="flex justify-between"><span>Venta bruta</span><span id="s-gross">120 €</span></div><div class="flex justify-between"><span>Comisión (10 %)</span><span id="s-fee">−12 €</span></div></div>
        <ul class="relative mt-6 space-y-2 text-xs text-mute"><li>✓ Publicar es gratis</li><li>✓ Cobro automático tras el evento</li><li>✓ Soporte si el comprador tiene problemas</li></ul>
      </div>
    </aside>
  </div>
</section>
