---
---

<section id="v-checkout" class="view" data-view="checkout">
  <div class="mx-auto max-w-7xl px-5 pb-10 pt-32">
    <a href="#/" id="co-back" class="text-sm text-mute hover:text-white">← Volver al evento</a>
    <h1 class="mt-4 text-[clamp(2.2rem,6vw,5rem)] font-bold uppercase leading-none" data-split>Casi <span class="text-lime">tuyo</span></h1>

    <ol class="mt-10 grid grid-cols-4 gap-2 text-xs font-bold uppercase tracking-widest" id="co-steps" aria-label="Progreso">
      {["Entradas", "Tus datos", "Pago", "Listo"].map((s, i) => (<li class="co-step" data-i={i}><i class="mb-2 block h-1 rounded bg-white/10"><b class="block h-full w-0 rounded bg-lime"></b></i><span class="text-mute">{i + 1}. {s}</span></li>))}
    </ol>

    <div class="mt-10 grid gap-8 lg:grid-cols-[1.4fr_1fr]">
      <div class="glass relative overflow-hidden rounded-[2rem] p-6 sm:p-10" id="co-panel">
        <!-- 0 -->
        <div class="co-pane space-y-5" data-pane="0">
          <h2 class="text-2xl font-semibold">Revisa tu selección</h2>
          <ul id="co-items" class="space-y-3"></ul>
          <div class="flex flex-wrap items-center gap-3 rounded-2xl border border-line bg-white/5 p-4 text-sm"><span class="text-lime">✓</span> Entradas verificadas y entrega garantizada.</div>
          <button class="btn btn-lime co-next !px-8" data-magnetic>Continuar →</button>
        </div>
        <!-- 1 -->
        <form class="co-pane hidden space-y-4" data-pane="1" novalidate>
          <h2 class="text-2xl font-semibold">¿A nombre de quién?</h2>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="field"><input id="c-name" placeholder=" " autocomplete="name" required /><label for="c-name">Nombre y apellidos</label><p class="msg"></p></div>
            <div class="field"><input id="c-email" type="email" placeholder=" " autocomplete="email" required /><label for="c-email">Email</label><p class="msg"></p></div>
          </div>
          <div class="flex gap-3"><button type="button" class="btn btn-ghost co-prev">← Atrás</button><button class="btn btn-lime co-next" data-magnetic>Continuar →</button></div>
        </form>
        <!-- 2 -->
        <form class="co-pane hidden space-y-4" data-pane="2" novalidate>
          <h2 class="text-2xl font-semibold">Pago seguro</h2>
          <div class="relative mx-auto h-48 w-full max-w-sm overflow-hidden rounded-3xl bg-gradient-to-br from-violet via-blue to-cyan p-6 shadow-2xl" id="paycard">
            <div class="absolute -right-10 -top-10 h-44 w-44 rounded-full bg-white/15"></div>
            <p class="font-display text-sm font-semibold lowercase">handticket</p>
            <p class="mt-8 font-display text-xl tracking-[0.2em]" id="pc-num">•••• •••• •••• ••••</p>
            <div class="mt-5 flex justify-between text-xs uppercase"><span id="pc-name" class="truncate">Nombre Apellido</span><span id="pc-exp">MM/AA</span></div>
          </div>
          <div class="field"><input id="p-num" inputmode="numeric" maxlength="19" placeholder=" " autocomplete="cc-number" required /><label for="p-num">Número de tarjeta</label><p class="msg"></p></div>
          <div class="grid grid-cols-2 gap-4">
            <div class="field"><input id="p-exp" inputmode="numeric" maxlength="5" placeholder=" " autocomplete="cc-exp" required /><label for="p-exp">MM/AA</label><p class="msg"></p></div>
            <div class="field"><input id="p-cvc" inputmode="numeric" maxlength="4" placeholder=" " autocomplete="cc-csc" required /><label for="p-cvc">CVC</label><p class="msg"></p></div>
          </div>
          <p class="rounded-2xl border border-line bg-white/5 p-3 text-xs text-mute">Entorno de demostración: no se realiza ningún cobro ni se guardan datos de tarjeta.</p>
          <div class="flex gap-3"><button type="button" class="btn btn-ghost co-prev">← Atrás</button><button class="btn btn-lime co-pay flex-1" data-magnetic>Pagar <span id="pay-amount"></span></button></div>
        </form>
        <!-- 3 -->
        <div class="co-pane hidden text-center" data-pane="3">
          <div class="mx-auto grid h-20 w-20 place-items-center rounded-full bg-lime text-black"><svg viewBox="0 0 24 24" class="h-10 w-10" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path id="ok-check" d="M5 12l5 5 9-10"></path></svg></div>
          <h2 class="mt-6 text-4xl font-bold uppercase">¡Estás <span class="text-lime">dentro!</span></h2>
          <p class="mx-auto mt-3 max-w-md text-mute">Tu entrada ya está en tu cuenta. Enséñala en la puerta con el QR.</p>
          <div class="ticket3d mt-8 grid place-items-center"><div class="card" id="done-card"><div class="holo"></div>
            <div class="poster h-[46%] w-full" id="done-art"></div>
            <div class="px-6 pt-5 text-left"><p class="text-[10px] font-bold uppercase tracking-[0.3em] text-lime">Entrada verificada</p><p class="mt-2 font-display text-2xl font-semibold leading-tight" id="done-title"></p><p class="text-sm text-white/60" id="done-meta"></p></div>
            <div class="absolute inset-x-6 bottom-6 flex items-end justify-between"><div class="qr w-24 rounded-lg bg-white/95 p-1.5" data-qr="done"></div><p class="font-display text-2xl font-bold" id="done-seats"></p></div></div></div>
          <div class="mt-10 flex flex-wrap justify-center gap-3"><a href="#/cuenta" class="btn btn-lime">Ver mis entradas</a><a href="#/eventos" class="btn btn-ghost">Seguir explorando</a></div>
        </div>
      </div>

      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="glass rounded-[2rem] p-6 sm:p-8">
          <div class="flex gap-4"><div class="poster-wrap h-24 w-20 shrink-0 !rounded-2xl"><div class="poster absolute inset-0" id="co-art"></div></div>
            <div><p class="text-xs font-bold uppercase tracking-widest text-lime" id="co-artist"></p><p class="font-display text-xl font-semibold leading-tight" id="co-title"></p><p class="mt-1 text-sm text-mute" id="co-meta"></p></div></div>
          <div class="mt-6 space-y-2 border-t border-line pt-5 text-sm">
            <div class="flex justify-between text-mute"><span id="co-qty">0 entradas</span><span id="co-base">0 €</span></div>
            <div class="flex justify-between text-mute"><span>Gastos de gestión</span><span id="co-fee">0 €</span></div>
            <div class="flex items-end justify-between pt-2"><span class="font-semibold">Total</span><span class="font-display text-4xl font-bold"><span id="co-total">0</span><span class="text-lime">€</span></span></div>
          </div>
          <div class="mt-5 flex items-center gap-2 rounded-2xl bg-lime/10 p-3 text-xs text-lime">🔒 Pago protegido por Handticket</div>
        </div>
      </aside>
    </div>
  </div>
</section>
