---
import { events, poster, cats } from "../data/events";
---

<section id="v-eventos" class="view" data-view="eventos">
  <div class="relative isolate overflow-hidden px-5 pb-10 pt-36">
    <div class="aurora -left-24 top-0 h-96 w-96 bg-violet/70"></div><div class="aurora -right-24 top-20 h-80 w-80 bg-cyan/40"></div>
    <div class="mx-auto max-w-7xl">
      <p class="text-sm font-bold uppercase tracking-[0.3em] text-lime">Explorar</p>
      <h1 class="mt-3 text-[clamp(2.6rem,9vw,8rem)] font-bold uppercase leading-[0.95]" data-split>Todos los <span class="text-outline-lime">eventos</span></h1>
      <div class="glass mt-10 grid gap-3 rounded-[2rem] p-3 sm:grid-cols-[1fr_auto_auto]">
        <div class="flex items-center gap-3 px-4"><svg viewBox="0 0 24 24" class="h-5 w-5 text-mute" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg><input id="xq" type="search" placeholder="Busca artista, evento, recinto o ciudad" aria-label="Buscar" class="w-full bg-transparent py-3 outline-none" /></div>
        <label class="flex items-center gap-3 rounded-full bg-white/5 px-5 py-3 text-sm"><span class="text-mute">Ciudad</span>
          <select id="xcity" class="bg-transparent font-semibold outline-none"><option class="bg-bg" value="">Todas</option>{[...new Set(events.map((e) => e.c))].map((c) => (<option class="bg-bg" value={c}>{c}</option>))}</select></label>
        <label class="flex items-center gap-3 rounded-full bg-white/5 px-5 py-3 text-sm"><span class="text-mute">Ordenar</span>
          <select id="xsort" class="bg-transparent font-semibold outline-none"><option class="bg-bg" value="date">Fecha</option><option class="bg-bg" value="asc">Precio ↑</option><option class="bg-bg" value="desc">Precio ↓</option></select></label>
      </div>
      <div class="no-scrollbar -mx-5 mt-5 flex gap-2 overflow-x-auto px-5">
        {cats.map((c, i) => (<button type="button" data-xcat={c.id} aria-selected={i === 0} class="xcat shrink-0 rounded-full border border-line bg-white/5 px-5 py-2.5 text-sm font-semibold transition hover:border-white/40 aria-selected:border-lime aria-selected:bg-lime aria-selected:text-black">{c.n}</button>))}
      </div>
    </div>
  </div>
  <div class="mx-auto max-w-7xl px-5">
    <p id="xcount" class="mb-6 text-sm text-mute"></p>
    <div id="xgrid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {events.map((e, i) => (
        <a href={`#/evento/${e.id}`} data-cat={e.cat} data-city={e.c} data-p={e.p} data-date={e.date} data-s={`${e.t} ${e.a} ${e.v} ${e.c} ${e.cat}`.toLowerCase()} class="xev group block" data-view-cursor>
          <div class="poster-wrap aspect-[4/5] tilt" data-tilt>
            <div class="poster absolute -inset-[4%] transition duration-700 group-hover:scale-110" set:html={poster(e, 70 + i)}></div><div class="glare"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent"></div>
            <div class="absolute left-4 top-4 rounded-2xl bg-white/95 px-3 py-1.5 text-center leading-none text-black"><p class="font-display text-xl font-bold">{e.day}</p><p class="text-[10px] font-bold tracking-widest">{e.mon}</p></div>
            {e.left < 20 && <span class="absolute right-4 top-4 rounded-full bg-lime px-3 py-1 text-xs font-extrabold text-black">Quedan {e.left}</span>}
            <div class="absolute inset-x-0 bottom-0 p-5"><p class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/70">{e.a}</p><p class="font-display text-xl font-semibold leading-tight">{e.t}</p></div>
          </div>
          <div class="mt-3 flex items-center justify-between"><p class="truncate text-sm text-mute">{e.v} · {e.c}</p><p class="shrink-0 text-sm"><span class="text-mute">desde</span> <b>{e.p}€</b></p></div>
        </a>
      ))}
    </div>
    <p id="xempty" class="hidden py-24 text-center text-mute">No hay eventos con esos filtros.</p>
  </div>
</section>
