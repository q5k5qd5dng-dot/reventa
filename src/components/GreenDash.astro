---
const days = [30, 22, 40, 52, 36, 60, 48, 70, 55, 78, 62, 84, 66, 90, 72, 80, 68, 86, 74, 92];
const cols = ["Hoy", "Ayer", "Semana", "Mes"];
---
<div data-fit="860" data-vis="0.86" class="w-full overflow-hidden rounded-xl border border-white/10 bg-[#0a0a0c] text-[11px] text-white/55">
  <div class="flex items-center gap-2 border-b border-white/10 px-4 py-2.5"><span class="text-white/40">←</span><span class="text-white/70">Resumen</span></div>
  <div class="space-y-3 p-4">
    <div class="grid grid-cols-3 gap-2">
      {[["Ingresos totales", "156.651 €"], ["Entradas", "16.376"], ["Asistentes", "26.536"]].map(([a, b]) => <div class="rounded-md bg-white/[0.05] p-3"><p class="text-[9px]">{a}</p><p class="mt-1.5 text-sm font-semibold text-white">{b}</p></div>)}
    </div>
    <div class="rounded-md bg-white/[0.05] p-3">
      <div class="flex gap-3 text-[9px]"><span class="text-emerald-400">● Online</span><span class="text-sky-400">● Taquilla</span><span class="text-amber-400">● RRPP</span></div>
      <div class="mt-3 flex h-36 items-end gap-1.5">
        {days.map((h, i) => <div class="flex h-full flex-1 flex-col justify-end"><i class="block rounded-t-sm bg-amber-400" style={`height:${h * 0.18}%`}></i><i class="block bg-emerald-500" style={`height:${h * 0.82}%`}></i></div>)}
      </div>
    </div>
    <div class="grid grid-cols-4 gap-2">
      {cols.map((c, i) => (
        <div class="rounded-md bg-white/[0.05] p-2">
          <p class="flex justify-between text-[9px]"><span>{c}</span><span class="text-emerald-400">+{4 + i * 3} %</span></p>
          <div class="mt-2 space-y-1.5">{[0, 1, 2, 3].map((r) => <div class="flex items-center gap-1.5"><i class="h-2.5 w-2.5 rounded-sm bg-indigo-400/70"></i><i class="h-1.5 flex-1 rounded bg-white/10"></i><i class="h-1.5 w-4 rounded bg-emerald-500/60"></i></div>)}</div>
        </div>
      ))}
    </div>
  </div>
</div>
