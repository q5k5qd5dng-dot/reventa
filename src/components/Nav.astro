---
import { menus, sectorLinks } from "../data/site";
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-white/[0.06] bg-black/60 backdrop-blur-md">
  <nav class="mx-auto flex h-14 max-w-[860px] items-center justify-between px-5 text-[13px]">
    <a href="/" class="flex items-center gap-2 text-[17px] font-bold tracking-tight"><img src="/favicon.svg" alt="" class="h-5 w-5" />wave</a>
    <ul class="hidden gap-1 text-white/80 md:flex">
      {menus.map(([n, items]) => (
        <li class="group relative">
          <button type="button" class="flex items-center gap-1 rounded-md px-3 py-2 transition hover:text-white group-focus-within:text-white">{n}<svg width="8" height="8" viewBox="0 0 10 10" class="transition group-hover:rotate-180 group-focus-within:rotate-180" aria-hidden="true"><path d="M2 3.5l3 3 3-3" stroke="currentColor" fill="none" stroke-width="1.4"/></svg></button>
          <div class="invisible absolute left-1/2 top-full z-50 w-[360px] -translate-x-1/2 translate-y-1 pt-2 opacity-0 transition duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
            <div class="rounded-xl border border-white/10 bg-[#0c0c10] p-2 shadow-2xl">
              <div class="grid grid-cols-2 gap-1">
                {items.map(([t, d, h]) => <a href={h} class="rounded-lg p-3 transition hover:bg-white/[0.06]"><p class="text-[12px] font-semibold text-white">{t}</p><p class="mt-0.5 text-[10px] text-white/50">{d}</p></a>)}
              </div>
              {n === "Soluciones" && (
                <div class="mt-1 border-t border-white/10 px-3 pb-2 pt-3">
                  <p class="text-[9px] font-semibold uppercase tracking-[0.18em] text-indigo-300">Por sector</p>
                  <div class="mt-2 flex flex-wrap gap-1.5">{sectorLinks.map(([t, h]) => <a href={h} class="rounded-full border border-white/10 px-2.5 py-1 text-[10px] text-white/80 transition hover:border-indigo-400 hover:text-white">{t}</a>)}</div>
                </div>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-4">
      <a href="#" class="hidden text-white/80 hover:text-white sm:block">Login</a>
      <a href="/#demo" class="rounded-md bg-indigo-600 px-3.5 py-1.5 text-xs font-semibold text-white transition hover:bg-indigo-500">Crear cuenta</a>
      <details class="group md:hidden">
        <summary class="grid h-8 w-8 cursor-pointer place-items-center rounded-md border border-white/15" aria-label="Menú">
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 3h12M1 7h12M1 11h12" stroke="#fff" stroke-width="1.4" class="group-open:hidden"/><path d="M2 2l10 10M12 2L2 12" stroke="#fff" stroke-width="1.4" class="hidden group-open:block"/></svg>
        </summary>
        <div class="absolute inset-x-0 top-full max-h-[75vh] space-y-5 overflow-y-auto border-b border-white/10 bg-black/95 p-5 backdrop-blur-xl">
          {menus.map(([n, items]) => (
            <div><p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-indigo-300">{n}</p><ul class="mt-2 space-y-2">{items.map(([t, , h]) => <li><a href={h} class="text-sm text-white/85">{t}</a></li>)}</ul></div>
          ))}
          <div><p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-indigo-300">Por sector</p><ul class="mt-2 space-y-2">{sectorLinks.map(([t, h]) => <li><a href={h} class="text-sm text-white/85">{t}</a></li>)}</ul></div>
        </div>
      </details>
    </div>
  </nav>
</header>
