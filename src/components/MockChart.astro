---
const bars = [30, 42, 38, 55, 48, 66, 60, 78, 72, 90, 84, 100];
const { class: cls = "" } = Astro.props;
---
<div class={`overflow-hidden rounded-xl border border-white/10 bg-[#0b0b10] text-[10px] text-white/60 shadow-2xl ${cls}`}>
  <div class="flex items-center gap-1.5 border-b border-white/10 px-3 py-2">
    <i class="h-2 w-2 rounded-full bg-white/20"></i><i class="h-2 w-2 rounded-full bg-white/20"></i><i class="h-2 w-2 rounded-full bg-white/20"></i>
    <span class="ml-3 rounded bg-white/5 px-2 py-0.5">wave.app / evento</span>
  </div>
  <div class="grid grid-cols-[28%_1fr] gap-3 p-3">
    <div class="space-y-2">
      {["Resumen", "Entradas", "Taquilla", "RRPP", "CRM", "Reservas"].map((s, i) => (
        <div class={`rounded px-2 py-1.5 ${i === 0 ? "bg-wave/20 text-wave" : "bg-white/5"}`}>{s}</div>
      ))}
    </div>
    <div>
      <div class="grid grid-cols-3 gap-2">
        {[["Vendidas", "1.248"], ["Aforo", "86%"], ["Ingresos", "18.4k€"]].map(([a, b]) => (
          <div class="rounded-lg bg-white/5 p-2"><p>{a}</p><p class="mt-1 text-sm font-bold text-white">{b}</p></div>
        ))}
      </div>
      <div class="mt-3 flex h-24 items-end gap-1.5 rounded-lg bg-white/5 p-2">
        {bars.map((h) => <div class="flex-1 rounded-sm bg-gradient-to-t from-wave/30 to-wave" style={`height:${h}%`}></div>)}
      </div>
      <div class="mt-3 space-y-1.5">
        {["Ana · 2 entradas", "Marcos · VIP", "Lucía · 4 entradas"].map((r) => (
          <div class="flex justify-between rounded bg-white/5 px-2 py-1.5"><span>{r}</span><span class="text-wave">Pagado</span></div>
        ))}
      </div>
    </div>
  </div>
</div>
