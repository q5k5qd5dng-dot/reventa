---
import { footer, sectorLinks } from "../data/site";
---
<footer class="mx-auto max-w-[820px] px-5 pb-10 text-[8px] text-white/45">
  <div class="grid gap-8 md:grid-cols-[1fr_1.9fr]">
    <div>
      <p class="text-[10px] text-white/80">Descargar</p>
      <div class="mt-2.5 flex gap-1.5">
        <a href="#" class="rounded-md border border-white/20 px-3 py-1.5 text-white/80">iOS</a>
        <a href="#" class="rounded-md border border-white/20 px-3 py-1.5 text-white/80">Android</a>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-6 sm:grid-cols-[1.3fr_1.2fr_0.8fr_1fr]">
      <div><p class="font-semibold text-white">Soluciones</p><ul class="mt-3 space-y-3">{footer.a.map((l) => <li><a href="/#servicios" class="hover:text-white">{l}</a></li>)}</ul></div>
      <div><p class="invisible font-semibold">.</p><ul class="mt-3 space-y-3">{footer.b.map((l) => <li><a href="/#servicios" class="hover:text-white">{l}</a></li>)}</ul></div>
      <div><p class="font-semibold text-white">Sectores</p><ul class="mt-3 space-y-3">{sectorLinks.map(([l, h]) => <li><a href={h} class="hover:text-white">{l}</a></li>)}</ul></div>
      <div>
        <p class="font-semibold text-white">Nosotros</p>
        <ul class="mt-3 space-y-3">{footer.n.map((l) => <li><a href="#" class="hover:text-white">{l}</a></li>)}</ul>
        <p class="mt-5 font-bold text-white">Recursos</p>
        <ul class="mt-3 space-y-3">{footer.r.map((l) => <li><a href="#" class="hover:text-white">{l}</a></li>)}</ul>
      </div>
    </div>
  </div>
  <div class="mt-12 flex flex-wrap items-center justify-between gap-4">
    <p class="flex flex-wrap gap-x-2">{["Legal", "Privacidad", "Cookies", "Canal de denuncias", "Política de devolución"].map((l, i) => <span><a href="#" class="hover:text-white">{l}</a>{i < 4 ? <span class="ml-2 text-white/20">|</span> : null}</span>)}</p>
    <div class="flex items-center gap-1.5">
      {["IG", "TT", "YT", "in"].map((s) => <a href="#" class="grid h-6 w-6 place-items-center rounded border border-white/15 text-[7px] text-white/70">{s}</a>)}
      <span class="ml-1 flex items-center gap-4 rounded border border-white/15 px-2.5 py-1.5 text-white/80">Español <svg width="8" height="8" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" stroke="currentColor" fill="none" stroke-width="1.4"/></svg></span>
    </div>
  </div>
  <div class="mt-6 h-[3px] rounded bg-white/15"></div>
  <div class="mt-5 grid gap-4 sm:grid-cols-3">
    <div><p class="text-[7px] font-semibold uppercase tracking-wider text-white/70">Una empresa de</p><p class="mt-2 font-semibold">Wave</p></div>
    <div><p class="text-[7px] font-semibold uppercase tracking-wider text-white/70">Impulsado por</p><p class="mt-2 text-base font-semibold text-white/70">Zaragoza</p></div>
    <div><p class="text-[7px] font-semibold uppercase tracking-wider text-white/70">Proyecto en desarrollo</p><p class="mt-2 max-w-[200px] leading-snug">Wave es un proyecto en crecimiento desde Zaragoza para el ocio nocturno.</p></div>
  </div>
  <p class="mt-6 text-white/40">© {new Date().getFullYear()} Wave. Todos los derechos reservados. siemprewave.es</p>
</footer>
