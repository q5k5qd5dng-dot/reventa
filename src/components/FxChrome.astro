---
// Preloader, barra superior, barra flotante móvil y menú a pantalla completa. Se usa en todas las páginas animadas.
const links = [["Inicio", "/"], ["Discotecas", "/discotecas"], ["Promotores", "/promotores"], ["Beach Clubs", "/beach-clubs"], ["Festivales", "/festivales"], ["Pide tu demo", "#demo"]];
---
<div class="fx-preloader" aria-hidden="true">
  <div class="fx-pre-title"><div class="fx-pre-logo"><img src="/brand/wave-lockup.png" alt="" width="1240" height="321" decoding="async" fetchpriority="high" /></div></div>
  <i class="fx-pre-bar"></i>
</div>
<div class="fx-split" aria-hidden="true">
  <div class="fx-pre-title"><div class="fx-pre-logo"><img src="/brand/wave-lockup.png" alt="" width="1240" height="321" decoding="async" /></div></div>
  <i class="fx-pre-bar"></i>
</div>
<div class="fx-pre-ui"><button type="button" class="fx-pre-sound mono" data-sound-opt>Activar sonido</button></div>
<div class="fx-tags" aria-hidden="true">
  <div class="fx-tag fx-tag-1 mono"><p>Entradas</p></div>
  <div class="fx-tag fx-tag-2 mono"><p>RRPP</p></div>
  <div class="fx-tag fx-tag-3 mono"><p>Check-in</p></div>
</div>

<nav class="fx-nav" aria-label="Principal">
  <a href="/" class="fx-logo" aria-label="Wave, inicio">
    <img class="fx-logo-ic" src="/brand/wave-icon-lockup.png" alt="" width="30" height="30" />
    <span class="fx-logo-tx" aria-hidden="true">Wave</span>
    <img class="fx-logo-wm" src="/brand/wave-wordmark.png" alt="" width="102" height="30" />
  </a>
  <ul class="fx-inline">
    <li><a href="/#servicios" data-spy="servicios">Herramientas</a></li>
    <li><a href="/#marca-blanca" data-spy="marca-blanca">Marca blanca</a></li>
    <li><a href="/#app" data-spy="app">La app</a></li>
    <li class="has-dd">
      <button type="button" aria-haspopup="true">Sectores <svg width="9" height="9" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" stroke="currentColor" fill="none" stroke-width="1.5"/></svg></button>
      <div class="dd"><div>
        <a href="/discotecas"><b>Discotecas</b><small>Entradas, mesas y accesos</small></a>
        <a href="/promotores"><b>Promotores</b><small>RRPP, listas y comisiones</small></a>
        <a href="/beach-clubs"><b>Beach Clubs</b><small>Reservas de día y de noche</small></a>
        <a href="/festivales"><b>Festivales</b><small>Abonos, zonas y accesos</small></a>
      </div></div>
    </li>
    <li><a href="/#faq" data-spy="faq">Preguntas</a></li>
  </ul>
  <div class="fx-nav-right">
    <button type="button" class="fx-sound" data-sound-toggle aria-pressed="false" aria-label="Activar sonido" title="Sonido">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5z"/><path class="w1" d="M15.5 9.2a4 4 0 010 5.6"/><path class="w2" d="M18 6.6a7.600 7.600 0 010 10.800"/><path class="mu" d="M16 9.500l5 5M21 9.500l-5 5"/></svg>
    </button>
    <a class="fx-nav-cta" href="#demo">Solicita una demo <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    <button type="button" class="fx-toggler mono" data-menu-toggle aria-expanded="false" aria-controls="fx-menu"><span class="lbl">Menú</span><span class="lbl">Cerrar</span></button>
  </div>
  <i class="fx-progress" aria-hidden="true"></i>
</nav>

<div class="fx-dock" role="navigation" aria-label="Acciones rápidas">
  <a href="#demo" class="fx-dock-cta">Solicita una demo</a>
  <button type="button" class="fx-dock-menu" data-menu-toggle aria-expanded="false" aria-controls="fx-menu" aria-label="Menú">
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path class="l1" d="M2 5h14" /><path class="l2" d="M2 13h14" /></svg>
  </button>
</div>

<div class="fx-menu" id="fx-menu">
  <div class="fx-menu-info">
    <div><p class="mono">Wave</p><p class="mono">Ticketing + comunidad</p><p class="mono">Zaragoza</p></div>
    <div><p class="mono">Habla con nosotros</p><p class="mono">hola@siemprewave.es</p></div>
    <div><p class="mono">Para locales</p><p class="mono">Discotecas · Promotoras · Beach Clubs · Festivales</p></div>
  </div>
  <div class="fx-links">
    <div class="fx-hi"></div>
    {links.map(([t, h]) => <div class="fx-menu-link"><a href={h}><span>{t}</span></a></div>)}
  </div>
</div>
