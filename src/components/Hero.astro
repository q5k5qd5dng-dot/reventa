---
const listings = [
  { name: "Festival de verano", meta: "Sáb 12 jul · Zaragoza", price: "desde 45 €" },
  { name: "Concierto indie", meta: "Vie 18 jul · Madrid", price: "desde 32 €" },
];
---

<section class="relative overflow-hidden px-4 pb-24 pt-36 sm:pt-44">
  <!-- fondo -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute left-1/2 top-[-12rem] h-[34rem] w-[60rem] -translate-x-1/2 rounded-full bg-brand/25 blur-[120px]"></div>
    <div
      class="absolute inset-0 opacity-[0.35]"
      style="background-image: radial-gradient(#0a0a0a14 1px, transparent 1px); background-size: 24px 24px; mask-image: linear-gradient(to bottom, black, transparent 75%); -webkit-mask-image: linear-gradient(to bottom, black, transparent 75%);"
    >
    </div>
  </div>

  <div class="mx-auto max-w-4xl text-center">
    <a
      href="#ventajas"
      class="reveal inline-flex items-center gap-2 rounded-full border border-black/10 bg-white py-1.5 pl-2 pr-4 text-sm font-medium shadow-sm"
    >
      <span class="rounded-full bg-brand px-2.5 py-0.5 text-xs font-bold text-white">Nuevo</span>
      Entradas verificadas
      <svg viewBox="0 0 24 24" class="h-4 w-4 text-ink/50" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
    </a>

    <h1 class="reveal mt-7 text-balance text-5xl font-extrabold leading-[1.02] tracking-[-0.035em] sm:text-7xl">
      Entradas agotadas, <span class="text-brand">otra vez disponibles</span>
    </h1>

    <p class="reveal mx-auto mt-6 max-w-xl text-balance text-lg leading-relaxed text-ink/60 sm:text-xl">
      Compra y vende entradas entre personas, con pago protegido y QR verificado.
    </p>

    <div class="reveal mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="#cta" class="inline-flex items-center gap-2 rounded-full bg-ink px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-black/10 transition hover:-translate-y-0.5 hover:bg-brand">
        Ver entradas
      </a>
      <a href="#vender" class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white px-7 py-3.5 text-base font-semibold transition hover:-translate-y-0.5 hover:border-ink">
        Vender la mía
      </a>
    </div>

    <p class="reveal mt-5 text-sm text-ink/45">Sin cuota. Solo pagas cuando vendes.</p>
  </div>

  <!-- mockup -->
  <div class="reveal relative mx-auto mt-16 max-w-4xl">
    <div class="rounded-[2rem] border border-black/10 bg-white p-3 shadow-[0_40px_90px_-30px_rgba(33,174,192,0.45)] sm:rounded-[2.5rem] sm:p-4">
      <div class="grid gap-3 rounded-[1.5rem] bg-ink p-4 text-white sm:grid-cols-[1.2fr_1fr] sm:rounded-[2rem] sm:p-6">
        <div class="relative min-h-[16rem] overflow-hidden rounded-2xl bg-gradient-to-br from-brand via-brand-dark to-ink p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-white/70">Entrada disponible</p>
          <p class="mt-2 text-3xl font-extrabold leading-tight sm:text-4xl">Festival de verano</p>
          <p class="mt-1 text-white/80">Zaragoza · Sáb 12 jul</p>
          <div class="absolute bottom-6 left-6 right-6 flex items-center justify-between">
            <span class="text-2xl font-extrabold">45 €</span>
            <span class="rounded-full bg-white px-4 py-2 text-sm font-bold text-ink">Comprar</span>
          </div>
        </div>
        <ul class="flex flex-col gap-3">
          {listings.map((e) => (
            <li class="rounded-2xl bg-white/[0.07] p-4">
              <p class="font-bold">{e.name}</p>
              <p class="text-sm text-white/60">{e.meta}</p>
              <p class="mt-3 inline-block rounded-full bg-brand/20 px-3 py-1 text-xs font-semibold text-brand">{e.price}</p>
            </li>
          ))}
          <li class="flex flex-1 items-center justify-between rounded-2xl bg-white p-4 text-ink">
            <div>
              <p class="text-sm font-bold">Entrada verificada</p>
              <p class="text-xs text-ink/50">QR único, transferido a ti</p>
            </div>
            <span class="grid h-12 w-12 grid-cols-3 gap-0.5 rounded-lg bg-ink p-1.5" aria-hidden="true">
              {[1,0,1,0,1,0,1,1,0].map((on) => <i class={on ? "rounded-[2px] bg-white" : "rounded-[2px] bg-ink"}></i>)}
            </span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
