---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import FinalCta from "../components/FinalCta.astro";
import HeroDash from "../components/HeroDash.astro";
import GreenDash from "../components/GreenDash.astro";
import PreMock from "../components/PreMock.astro";
import { sectors, sectorLinks } from "../data/site";

export function getStaticPaths() {
  return sectors.map((s) => ({ params: { sector: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const others = sectorLinks.filter(([, h]) => h !== "/" + s.slug);
const icons = ["M5 12l4 4 10-10", "M4 7h16M4 12h16M4 17h10", "M12 3v18M3 12h18", "M4 18l5-6 4 3 7-9", "M12 3a9 9 0 100 18 9 9 0 000-18z", "M5 5h14v14H5z"];
---
<Base title={`Wave para ${s.name.toLowerCase()} · Tecnología all-in-one`} description={s.lead} bodyClass="bg-black text-white">
  <Nav />
  <main class="overflow-x-hidden">
    <section class="relative overflow-hidden pb-24 pt-[120px] text-center">
      <div class="hero-bg absolute inset-0"></div>
      <div class="hero-dots absolute inset-0"></div>
      <canvas id="hero-fx" class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
      <i class="stage-beam sway-a left-[4%]"></i><i class="stage-beam sway-b left-[58%]"></i><i class="stage-beam sway-c left-[30%] opacity-70"></i>
      <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-b from-transparent to-black"></div>
      <div class="relative mx-auto max-w-[820px] px-5">
        <span class="inline-block rounded-full border border-indigo-400/60 px-3 py-1 text-[9px] text-indigo-200">{s.eyebrow}</span>
        <h1 class="mt-5 text-[32px] font-semibold leading-[1.15] tracking-tight text-white/90 md:text-[42px]">{s.h1[0]}<br /><span class="text-indigo-300">{s.h1[1]}</span></h1>
        <p class="mx-auto mt-5 max-w-md text-[11px] leading-relaxed text-white/60">{s.lead}</p>
        <div class="mt-6 flex justify-center gap-2.5 text-xs font-semibold">
          <a href="/#demo" class="rounded-md bg-white px-4 py-2.5 text-black transition hover:bg-white/85">Solicitar información</a>
          <a href="#como" class="rounded-md bg-indigo-600 px-4 py-2.5 text-white transition hover:bg-indigo-500">Cómo funciona</a>
        </div>
      </div>
    </section>

    <section class="relative -mt-8">
      <div class="cone"></div>
      <div class="relative mx-auto max-w-[820px] px-5">
        <div class="mx-auto w-full md:w-[82%]"><div class="reveal"><HeroDash /></div></div>
      </div>
    </section>

    <section class="mx-auto mt-28 max-w-[820px] px-5">
      <p class="text-center text-[8px] font-medium uppercase tracking-[0.25em] text-white/50">Todo lo que necesitas para <span class="text-indigo-300">{s.name.toLowerCase()}</span></p>
      <h2 class="reveal two-tone mt-3 text-center text-[28px] font-semibold leading-tight tracking-tight text-white/90 md:text-[32px]">Una plataforma. <span>Toda tu operativa.</span></h2>
      <div class="mt-9 grid gap-2.5 sm:grid-cols-2 md:grid-cols-3">
        {s.features.map(([t, d], i) => (
          <div class="reveal rounded-lg border border-white/10 bg-gradient-to-b from-[#161618] to-[#0c0c0e] p-5 transition hover:border-indigo-400/40">
            <span class="grid h-9 w-9 place-items-center rounded-lg bg-indigo-500/15 text-indigo-300"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[i % icons.length]}/></svg></span>
            <h3 class="mt-5 text-[13px] font-semibold text-white/90">{t}</h3>
            <p class="mt-2 text-[10px] leading-relaxed text-white/55">{d}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="como" class="mx-auto mt-28 max-w-[820px] px-5">
      <h2 class="reveal two-tone text-center text-[28px] font-semibold leading-tight tracking-tight text-white/90 md:text-[32px]">Cómo funciona <span>en tres pasos</span></h2>
      <div class="mt-9 grid items-start gap-6 md:grid-cols-[1fr_1fr]">
        <ol class="space-y-2.5">
          {s.steps.map(([t, d], i) => (
            <li class="reveal flex gap-4 rounded-lg border border-white/10 bg-white/[0.02] p-5">
              <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-indigo-600 text-[11px] font-semibold">{i + 1}</span>
              <div><p class="text-[13px] font-semibold">{t}</p><p class="mt-1 text-[10px] leading-relaxed text-white/55">{d}</p></div>
            </li>
          ))}
        </ol>
        <div class="reveal min-w-0 overflow-hidden"><GreenDash /></div>
      </div>
    </section>

    <section class="mx-auto mt-28 max-w-[820px] px-5">
      <div class="reveal grid overflow-hidden rounded-md bg-[#18181b] md:grid-cols-[1fr_1fr]">
        <div class="p-7">
          <p class="font-['Playfair_Display'] text-[24px] font-semibold italic">Tu {s.name.toLowerCase().replace(/s$/, "")}</p>
          <ul class="mt-6 space-y-3.5 text-[10px] text-white/65">
            {s.checks.map((c) => <li class="flex gap-3"><span class="grid h-4 w-4 shrink-0 place-items-center rounded bg-white/10 text-[8px]">✓</span><span>{c}</span></li>)}
          </ul>
        </div>
        <div class="grid place-items-center bg-[#131316] p-6"><div class="w-full max-w-[300px]"><PreMock variant={s.variant} /></div></div>
      </div>
    </section>

    <section class="mx-auto mt-28 grid max-w-[820px] gap-8 px-5 md:grid-cols-[1fr_1.2fr]">
      <div>
        <h2 class="text-[30px] font-bold tracking-tight">FAQs</h2>
        <p class="mt-3 max-w-[200px] text-[10px] leading-relaxed text-white/70">Dudas habituales de {s.name.toLowerCase()}. Si tienes otras, escríbenos y te ayudamos. 😊</p>
      </div>
      <div class="space-y-1">
        {s.faqs.map(([q, a], i) => (
          <details open={i === 0} class="group rounded-md px-3.5 py-3 open:bg-[#1a1b3a]">
            <summary class="flex cursor-pointer items-center justify-between gap-3 text-[10px] font-semibold"><span>{q}</span><svg class="h-3 w-3 shrink-0 transition group-open:rotate-180" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" stroke="currentColor" fill="none" stroke-width="1.4"/></svg></summary>
            <p class="mt-2.5 text-[9px] leading-relaxed text-white/70">{a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mx-auto mt-24 max-w-[820px] px-5">
      <p class="text-center text-[8px] font-medium uppercase tracking-[0.25em] text-white/50">Wave para otros <span class="text-indigo-300">sectores</span></p>
      <div class="mt-5 grid gap-2.5 sm:grid-cols-3">
        {others.map(([t, h]) => <a href={h} class="reveal rounded-lg border border-white/10 bg-white/[0.02] p-5 text-[13px] font-semibold transition hover:border-indigo-400/50">{t} <span class="text-indigo-300">→</span></a>)}
      </div>
    </section>

    <FinalCta title={["Llena tu ", "próxima", "noche con ", "Wave."]} />
  </main>
  <Footer />
</Base>
