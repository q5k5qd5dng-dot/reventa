---
import Layout from "../layouts/Layout.astro";
import { brand } from "../brand";

const cats = [
  { id: "all", n: "Todo", i: "M4 6h16M4 12h16M4 18h16" },
  { id: "musica", n: "Conciertos", i: "M9 18V5l11-2v13M9 18a3 3 0 11-6 0 3 3 0 016 0zm11-2a3 3 0 11-6 0 3 3 0 016 0z" },
  { id: "festival", n: "Festivales", i: "M3 20l9-16 9 16H3z" },
  { id: "deporte", n: "Deportes", i: "M12 3a9 9 0 100 18 9 9 0 000-18zM3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" },
  { id: "teatro", n: "Teatro", i: "M4 5h16v6a8 8 0 01-16 0V5zM9 10h.01M15 10h.01M9 15c1.5 1.5 4.5 1.5 6 0" },
  { id: "club", n: "Discotecas", i: "M12 3v18M5 8l7-5 7 5M5 16l7 5 7-5" },
];
const events = [
  { id: 1, t: "Gira Verano 2027", a: "Karol Vega", d: "24 jun 2027 · 20:00", v: "Estadio Metropolitano", c: "Madrid", p: 68, cat: "musica", g: "from-fuchsia-500 via-pink-500 to-orange-400", hot: true },
  { id: 2, t: "Duro Festival XXI", a: "Line-up completo", d: "10–11 oct", v: "Can Guitet", c: "Barcelona", p: 54, cat: "festival", g: "from-zinc-600 via-zinc-800 to-black", hot: true },
  { id: 3, t: "Viva Noche", a: "Banda Norte", d: "17 oct · 21:00", v: "Espacio Norte", c: "Madrid", p: 31, cat: "musica", g: "from-yellow-300 via-amber-400 to-orange-500" },
  { id: 4, t: "Jornada 12 de Liga", a: "Local vs Visitante", d: "8 nov · 16:00", v: "Estadio Municipal", c: "Sevilla", p: 42, cat: "deporte", g: "from-sky-400 via-blue-600 to-indigo-800" },
  { id: 5, t: "Noche Techno", a: "Resident DJs", d: "Sáb 25 oct · 00:00", v: "Sala Apolo", c: "Barcelona", p: 18, cat: "club", g: "from-violet-500 via-purple-700 to-zinc-900" },
  { id: 6, t: "El Rey de la Escena", a: "Musical", d: "3 dic · 20:30", v: "Teatro Principal", c: "Zaragoza", p: 39, cat: "teatro", g: "from-rose-500 via-red-600 to-red-950" },
  { id: 7, t: "Copa de Europa", a: "Semifinal", d: "29 abr 2027", v: "Estadio Central", c: "Bilbao", p: 120, cat: "deporte", g: "from-emerald-400 via-teal-600 to-slate-900", hot: true },
  { id: 8, t: "Sunset Sessions", a: "Chill & House", d: "1 nov · 18:00", v: "Terraza Ebro", c: "Zaragoza", p: 22, cat: "festival", g: "from-orange-400 via-rose-500 to-purple-700" },
];
const featured = [
  { t: "La final que no te puedes perder", s: "Entradas verificadas para la gran cita del año.", g: "from-sky-400 via-blue-600 to-indigo-900", tag: "Deportes" },
  { t: "La última gira", s: "Se despide de los escenarios. Quedan pocas.", g: "from-emerald-500 via-teal-700 to-slate-950", tag: "Conciertos" },
  { t: "Mujeres 2026", s: "Una noche histórica con artistas internacionales.", g: "from-fuchsia-500 via-purple-700 to-indigo-950", tag: "Festivales" },
  { t: "El estreno del año", s: "Teatro musical con aforo completo.", g: "from-rose-500 via-red-700 to-zinc-950", tag: "Teatro" },
];
const places = [
  { n: "Sala Apolo", c: "Barcelona", e: 14, g: "from-violet-500 to-zinc-900" },
  { n: "Palau Sant Jordi", c: "Barcelona", e: 9, g: "from-sky-500 to-slate-800" },
  { n: "WiZink Center", c: "Madrid", e: 17, g: "from-rose-500 to-zinc-900" },
  { n: "Auditorio de Zaragoza", c: "Zaragoza", e: 6, g: "from-amber-400 to-orange-700" },
  { n: "Estadio de La Cartuja", c: "Sevilla", e: 8, g: "from-emerald-400 to-teal-900" },
];
const steps = [
  { t: "Busca tu evento", d: "Encuentra conciertos, festivales, deportes y más. Aunque estén agotados." },
  { t: "Compra con garantía", d: "Pagas a Handticket, no al vendedor. Tu dinero queda protegido hasta que tengas la entrada." },
  { t: "Recibe y disfruta", d: "Te llega tu entrada verificada al instante. Solo queda entrar." },
];
const whys = [
  { t: "Reventa segura", d: `En ${brand.name} aplicamos un riguroso protocolo antifraude para garantizar que las entradas sean seguras.`, i: "M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5l8-3zM9 12l2 2 4-4" },
  { t: "Garantía de entrega", d: `Al contrario de otras plataformas, cuando compras en ${brand.name} la entrega de tus entradas está garantizada.`, i: "M4 4h16v16H4zM8 12l3 3 5-6" },
  { t: "Pago asegurado", d: "Si vendes, recibes tu dinero de forma automática tras el evento. Si compras, tu pago queda protegido.", i: "M3 6h18v12H3zM3 10h18M7 15h3" },
  { t: "100% legal", d: "Precios dentro de la normativa y vendedores verificados. Reventa sin sustos.", i: "M12 3v18M5 7h14M5 7l-2 6a3 3 0 006 0L7 7M19 7l-2 6a3 3 0 006 0l-2-6" },
];
const reviews = [
  { n: "Iván", r: "Tenía miedo de comprar en plataformas de reventa, pero el evento estaba agotado, el proceso fue fácil y pude usar la entrada sin problemas.", e: "Concierto · Madrid" },
  { n: "Lucía", r: "Vendí dos entradas que no podía usar en menos de un día. El dinero llegó solo, sin tener que perseguir a nadie.", e: "Festival · Barcelona" },
  { n: "Marcos", r: "Me gustó saber que pagaba a la plataforma y no a un desconocido. Entrada en el móvil al momento.", e: "Fútbol · Sevilla" },
];
const faq = [
  { q: "¿Es legal comprar en Handticket?", a: "Sí. Operamos dentro de la normativa y verificamos a vendedores y entradas antes de publicarlas." },
  { q: "¿Qué pasa si la entrada no funciona?", a: "Te devolvemos el dinero o te conseguimos una equivalente. Tu pago está protegido hasta que accedes al evento." },
  { q: "¿Cuánto cuesta vender mis entradas?", a: "Publicar es gratis. Solo cobramos una comisión cuando la entrada se vende." },
  { q: "¿Cuándo recibo mi dinero si vendo?", a: "De forma automática tras el evento, directamente en tu cuenta." },
  { q: "¿Cómo recibo mi entrada?", a: "En tu cuenta y en la app, normalmente al instante. Algunos eventos requieren transferencia oficial y te avisamos paso a paso." },
];
const stats = [
  { n: "+120.000", l: "entradas entregadas", to: 120000, pre: "+", dec: 0 },
  { n: "4,8/5", l: "valoración media", to: 4.8, suf: "/5", dec: 1 },
  { n: "100%", l: "pago protegido", to: 100, suf: "%", dec: 0 },
  { n: "24/7", l: "soporte" },
];
const stars = [0, 1, 2, 3, 4];
---

<Layout title={`${brand.name} · Reventa de entradas segura y legal`} description="Compra y vende entradas de conciertos, festivales y deportes con pago protegido, entrega garantizada y vendedores verificados.">
  <!-- NAV -->
  <header id="nav" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4">
      <a href="/" class="flex items-center gap-2 text-white transition-colors" id="logo" aria-label={`${brand.name}, inicio`}>
        <svg viewBox="0 0 32 32" class="h-8 w-8" aria-hidden="true"><rect width="32" height="32" rx="9" fill="currentColor" opacity=".18"></rect><path d="M8 11h16v4a2 2 0 000 4v4H8v-4a2 2 0 000-4v-4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path><path d="M19 11v12" stroke="currentColor" stroke-width="2" stroke-dasharray="2 2.5"></path></svg>
        <span class="text-2xl font-extrabold lowercase tracking-tight">hand<span class="opacity-70">ticket</span></span>
      </a>
      <nav class="hidden items-center gap-8 text-sm font-medium text-white/90 md:flex" id="links" aria-label="Principal">
        <a href="#eventos" class="hover:opacity-70">Eventos</a>
        <a href="#como" class="hover:opacity-70">Cómo funciona</a>
        <a href="#garantias" class="hover:opacity-70">Garantías</a>
        <a href="#faq" class="hover:opacity-70">Ayuda</a>
      </nav>
      <div class="flex items-center gap-2">
        <a href="#vender" class="hidden rounded-full px-4 py-2 text-sm font-semibold text-white hover:bg-white/15 sm:block" id="sell-link">Vender</a>
        <a href="#app" class="rounded-full border border-white/50 px-4 py-2 text-sm font-semibold text-white backdrop-blur transition hover:bg-white hover:text-blue-600" id="login">Iniciar sesión</a>
      </div>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="relative isolate overflow-hidden bg-gradient-to-b from-blue-600 via-blue-500 to-sky-300 pb-28 pt-32 text-white sm:pt-40">
      <div class="noise absolute inset-0 -z-10"></div>
      <div data-blob="-1" class="pointer-events-none absolute -left-24 top-10 -z-10 h-96 w-96 rounded-full bg-violet-500/40 blur-[110px]"></div>
      <div data-blob="1" class="pointer-events-none absolute -right-20 top-40 -z-10 h-96 w-96 rounded-full bg-cyan-300/40 blur-[110px]"></div>

      <div class="mx-auto max-w-7xl px-5">
        <div class="mx-auto max-w-5xl text-center">
          <p data-hero="badge" class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-1.5 text-sm font-medium backdrop-blur">
            <span class="h-2 w-2 rounded-full bg-emerald-300"></span> Entradas verificadas · Pago protegido
          </p>
          <h1 data-hero="title" class="mt-6 text-balance text-4xl font-semibold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">Reventa de entradas <span class="text-sky-100">segura y legal</span></h1>
          <p data-hero="sub" class="mt-5 text-lg text-white/90 sm:text-xl">Compra y vende entradas sin riesgos, aunque el evento esté agotado.</p>

          <form id="search" data-hero="search" class="relative mx-auto mt-9 max-w-2xl text-left" role="search" onsubmit="return false">
            <div class="flex items-center gap-3 rounded-2xl bg-white p-2 pl-5 text-ink shadow-2xl shadow-blue-900/30 ring-1 ring-black/5">
              <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-ink/40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
              <input id="q" type="search" autocomplete="off" placeholder="Busca eventos, recintos, ciudades o artistas" class="w-full bg-transparent py-3 text-base outline-none placeholder:text-ink/45" aria-label="Buscar eventos" />
              <button type="submit" data-magnetic class="shrink-0 rounded-xl bg-violet-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-violet-700">Buscar</button>
            </div>
          </form>

          <div data-hero="chips" class="mt-5 flex flex-wrap items-center justify-center gap-2 text-sm text-white/85">
            <span>Popular:</span>
            {["Madrid", "Barcelona", "Festivales", "Fútbol"].map((s) => (
              <button type="button" data-q={s} class="quick rounded-full bg-white/15 px-3 py-1 backdrop-blur transition hover:bg-white/30">{s}</button>
            ))}
          </div>
        </div>

        <!-- tarjetas flotantes -->
        <div id="floaters" class="relative mx-auto mt-16 hidden h-56 max-w-5xl lg:block" aria-hidden="true">
          <div class="absolute left-0 top-6 w-64 rotate-[-6deg] rounded-2xl bg-white p-3 text-ink shadow-2xl" data-float="1">
            <div class="h-28 rounded-xl bg-gradient-to-br from-fuchsia-500 via-pink-500 to-orange-400"></div>
            <p class="mt-3 text-xs font-semibold text-violet-600">24 jun 2027</p>
            <p class="font-semibold">Gira Verano 2027</p>
            <p class="text-sm text-ink/55">desde 68 €</p>
          </div>
          <div class="absolute left-1/2 top-0 w-72 -translate-x-1/2 rounded-2xl bg-white p-3 text-ink shadow-2xl" data-float="2">
            <div class="flex items-center gap-3 rounded-xl bg-emerald-50 p-3">
              <span class="grid h-10 w-10 place-items-center rounded-full bg-emerald-500 text-white"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"></path></svg></span>
              <div><p class="text-sm font-semibold">Entrada verificada</p><p class="text-xs text-ink/55">Pago protegido · Entrega garantizada</p></div>
            </div>
            <div class="mt-3 flex items-center justify-between px-1">
              <div><p class="text-xs text-ink/50">2 × Entradas</p><p class="font-semibold">Copa de Europa</p></div>
              <p class="text-lg font-bold">240 €</p>
            </div>
            <div class="mt-3 rounded-xl bg-violet-600 py-2.5 text-center text-sm font-semibold text-white">Comprar ahora</div>
          </div>
          <div class="absolute right-0 top-10 w-60 rotate-[5deg] rounded-2xl bg-white p-3 text-ink shadow-2xl" data-float="3">
            <div class="h-28 rounded-xl bg-gradient-to-br from-violet-500 via-purple-700 to-zinc-900"></div>
            <p class="mt-3 text-xs font-semibold text-violet-600">25 oct · 00:00</p>
            <p class="font-semibold">Noche Techno</p>
            <p class="text-sm text-ink/55">desde 18 €</p>
          </div>
        </div>
      </div>
      <svg class="absolute inset-x-0 bottom-[-1px] h-10 w-full text-white sm:h-16" viewBox="0 0 1440 64" preserveAspectRatio="none" aria-hidden="true"><path fill="currentColor" d="M0 64V32C240 0 480 0 720 22s480 20 720-6v48z"></path></svg>
    </section>

    <!-- STATS -->
    <section class="mx-auto -mt-2 max-w-6xl px-5 pt-10">
      <dl data-reveal-group class="grid grid-cols-2 gap-6 text-center md:grid-cols-4">
        {stats.map((s) => (
          <div class="">
            <dt class="text-3xl font-bold tracking-tight text-violet-600 sm:text-4xl" data-count={s.to} data-pre={s.pre} data-suf={s.suf} data-dec={s.dec}>{s.n}</dt>
            <dd class="mt-1 text-sm text-ink/60">{s.l}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- EVENTOS -->
    <section id="eventos" class="mx-auto max-w-7xl px-5 pt-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 data-reveal class="text-3xl font-semibold tracking-tight sm:text-4xl">Sugerencias para ti</h2>
          <p class="mt-2 text-ink/60">Eventos con entradas disponibles ahora mismo.</p>
        </div>
        <p id="count" class="text-sm text-ink/50"></p>
      </div>

      <div class="no-scrollbar -mx-5 mt-6 flex gap-2 overflow-x-auto px-5 pb-1" role="tablist" aria-label="Categorías">
        {cats.map((c, i) => (
          <button type="button" role="tab" data-cat={c.id} aria-selected={i === 0} class="cat flex shrink-0 items-center gap-2 rounded-full border border-black/10 bg-white px-4 py-2.5 text-sm font-medium transition hover:border-violet-400 aria-selected:border-violet-600 aria-selected:bg-violet-600 aria-selected:text-white">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={c.i}></path></svg>{c.n}
          </button>
        ))}
      </div>

      <div id="grid" class="mt-8 grid gap-x-5 gap-y-9 sm:grid-cols-2 lg:grid-cols-4">
        {events.map((e) => (
          <a href="#app" data-cat={e.cat} data-s={`${e.t} ${e.a} ${e.v} ${e.c} ${e.cat}`.toLowerCase()} class="ev group block">
            <div class:list={["noise relative aspect-[4/5] overflow-hidden rounded-3xl bg-gradient-to-br transition duration-500 group-hover:-translate-y-1 group-hover:shadow-2xl group-hover:shadow-violet-500/25", e.g]}>
              <div class="absolute -right-8 -top-8 h-40 w-40 rounded-full border-[18px] border-white/15"></div>
              <div class="absolute -bottom-10 -left-6 h-44 w-44 rounded-full bg-white/10"></div>
              {e.hot && <span class="absolute left-3 top-3 rounded-full bg-white px-3 py-1 text-xs font-bold text-rose-600 shadow">🔥 Últimas</span>}
              <span class="absolute right-3 top-3 grid h-9 w-9 place-items-center rounded-full bg-black/25 text-white backdrop-blur transition group-hover:bg-white group-hover:text-rose-500">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 21s-8-5-8-11a4.5 4.5 0 018-2.7A4.5 4.5 0 0120 10c0 6-8 11-8 11z"></path></svg>
              </span>
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-5 pt-16 text-white">
                <p class="text-xs font-medium uppercase tracking-widest text-white/75">{e.a}</p>
                <p class="mt-1 text-xl font-semibold leading-tight">{e.t}</p>
              </div>
            </div>
            <p class="mt-3 text-sm font-medium text-violet-600">{e.d}</p>
            <p class="mt-0.5 truncate text-ink/70">{e.v} · {e.c}</p>
            <p class="mt-1 text-sm"><span class="text-ink/50">Desde</span> <span class="font-bold">{e.p} €</span></p>
          </a>
        ))}
      </div>
      <p id="empty" class="hidden py-16 text-center text-ink/55">No hemos encontrado eventos con esa búsqueda. Prueba con otra ciudad o artista.</p>
    </section>

    <!-- NO TE LO PUEDES PERDER -->
    <section class="mx-auto max-w-7xl px-5 pt-24">
      <h2 data-reveal class="text-3xl font-semibold tracking-tight sm:text-4xl">No te lo puedes perder</h2>
      <div class="no-scrollbar -mx-5 mt-8 flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-2">
        {featured.map((f) => (
          <a href="#app" data-card class:list={["noise group relative flex h-[26rem] w-72 shrink-0 snap-start flex-col justify-end overflow-hidden rounded-3xl bg-gradient-to-br p-6 text-white sm:w-80", f.g]}>
            <div class="absolute -right-10 top-10 h-52 w-52 rounded-full border-[22px] border-white/10 transition duration-500 group-hover:scale-110"></div>
            <span class="absolute left-5 top-5 rounded-full bg-white/20 px-3 py-1 text-xs font-semibold backdrop-blur">{f.tag}</span>
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
            <p class="relative text-3xl font-semibold leading-tight">{f.t}</p>
            <p class="relative mt-2 text-sm text-white/80">{f.s}</p>
            <span class="relative mt-4 inline-flex items-center gap-1 text-sm font-semibold">Ver entradas <svg viewBox="0 0 24 24" class="h-4 w-4 transition group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
          </a>
        ))}
      </div>
    </section>

    <!-- SITIOS POPULARES -->
    <section class="mx-auto max-w-7xl px-5 pt-24">
      <h2 data-reveal class="text-3xl font-semibold tracking-tight sm:text-4xl">Sitios populares</h2>
      <div class="no-scrollbar -mx-5 mt-8 flex snap-x gap-5 overflow-x-auto px-5 pb-2">
        {places.map((p) => (
          <a href="#app" data-card class="group w-60 shrink-0 snap-start">
            <div class:list={["noise relative aspect-[4/3] overflow-hidden rounded-3xl bg-gradient-to-br", p.g]}>
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_120%,rgba(255,255,255,.35),transparent_60%)] transition group-hover:scale-110"></div>
              <span class="absolute bottom-3 left-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-ink">{p.e} eventos</span>
            </div>
            <p class="mt-3 font-semibold">{p.n}</p>
            <p class="text-sm text-ink/55">{p.c}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- CÓMO FUNCIONA -->
    <section id="como" class="mx-auto max-w-7xl px-5 pt-28">
      <div data-reveal class="text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-violet-600">Cómo funciona</p>
        <h2 data-reveal class="mt-3 text-3xl font-semibold tracking-tight sm:text-5xl">Tres pasos y estás dentro</h2>
      </div>
      <ol data-reveal-group class="relative mt-14 grid gap-6 md:grid-cols-3">
        {steps.map((s, i) => (
          <li class="relative rounded-3xl bg-zinc-100 p-8">
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-violet-600 text-lg font-bold text-white shadow-lg shadow-violet-600/30">{i + 1}</span>
            <h3 class="mt-6 text-xl font-semibold">{s.t}</h3>
            <p class="mt-2 text-ink/65">{s.d}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- GARANTÍAS -->
    <section id="garantias" class="mx-auto max-w-7xl px-5 pt-28">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-violet-600">Garantías</p>
          <h2 data-reveal class="mt-3 text-3xl font-semibold tracking-tight sm:text-5xl">¿Por qué {brand.name}?</h2>
          <p class="mt-4 max-w-md text-lg text-ink/65">Hemos hecho de la reventa algo seguro: verificamos, protegemos tu pago y garantizamos que entras.</p>
          <div data-reveal-group class="mt-8 grid gap-4 sm:grid-cols-2">
            {whys.map((w) => (
              <div class="rounded-3xl border border-black/10 bg-white p-6 transition hover:-translate-y-1 hover:shadow-xl hover:shadow-violet-500/10">
                <span class="grid h-12 w-12 place-items-center rounded-2xl bg-violet-600 text-white shadow-lg shadow-violet-600/30">
                  <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><path d={w.i}></path></svg>
                </span>
                <h3 class="mt-4 font-semibold">{w.t}</h3>
                <p class="mt-1 text-sm leading-relaxed text-ink/60">{w.d}</p>
              </div>
            ))}
          </div>
        </div>

