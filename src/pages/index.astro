---
import Base from "../layouts/Base.astro";
import MockChart from "../components/MockChart.astro";
import MockPanel from "../components/MockPanel.astro";

const nav = ["Soluciones", "Servicios", "Recursos", "Nosotros"];
const chips = ["Discotecas", "Promotoras", "Beach Clubs", "Festivales", "Lounges", "Salas", "Terrazas", "Agencias de viajes", "Pubs", "Eventos privados"];
const preopen = ["Crea el evento en minutos", "Define tipos de entrada y precios", "Asigna RRPP y listas", "Publica y empieza a vender"];
const solution = [
  ["Controla el aforo en tiempo real", "Cada QR escaneado se refleja al instante en tu panel. Sabes cuánta gente hay dentro y cuánta falta por llegar."],
  ["Gestiona tus ventas online", "Entradas, pases, VIP y reservas en un solo sitio."],
  ["Conoce al cliente con nuestro CRM", "Perfiles, historial de asistencia y comunicación directa."],
  ["Vende en puerta con la taquilla", "Cobra en el momento sin salir del sistema."],
  ["Reparte comisiones a tus RRPP", "Enlaces propios, ventas y liquidaciones claras."],
];
const industry = [
  ["Discotecas", "Haz que tu operativa sea poderosa en cada detalle.", "🪩"],
  ["Promotoras", "Controla ventas, listas y equipos de RRPP.", "🎤"],
  ["Beach Clubs", "Reservas, mesas y entradas para el día y la noche.", "🌴"],
  ["Festivales", "Aforos grandes, accesos ágiles y pagos seguros.", "🎪"],
];
const diff = [
  ["🔒", "Base de datos 100% privada", "Los datos de tus clientes son tuyos. Wave no los usa para competir contigo."],
  ["⇄", "Experiencia social y API", "Conecta Wave con tu web y tus herramientas, y aprovecha la comunidad."],
  ["💳", "Métodos de pago para todo clubber", "Tarjeta, Apple Pay, Google Pay y más, con comisiones claras."],
];
const faqs = [
  ["¿Qué es Wave y para qué sirve?", "Wave es una ticketera con componente social: la gente descubre dónde salir, ve quién va y compra su entrada, y el local gestiona todo desde un panel."],
  ["¿Cuánto cuesta usar Wave?", "Te damos números claros: qué cobra Wave, qué cobra el procesador de pago y cuánto recibe tu local por entrada."],
  ["¿Puedo vender en puerta y online a la vez?", "Sí. Taquilla y venta online comparten aforo y datos en tiempo real."],
  ["¿Dónde está disponible Wave?", "Empezamos en Zaragoza y vamos abriendo más ciudades."],
];
const cols = [
  ["Soluciones", ["Discotecas", "Promotoras", "Beach Clubs", "Festivales"]],
  ["Servicios", ["Entradas y QR", "Taquilla", "CRM", "RRPP", "Reservas y VIP"]],
  ["Recursos", ["Blog", "Centro de ayuda", "Novedades"]],
  ["Nosotros", ["Quiénes somos", "Contacto", "Trabaja con nosotros"]],
];
---
<Base title="Wave · Tecnología all-in-one para tu evento" description="Entradas, taquilla, CRM, RRPP y una comunidad social para ocio nocturno. Wave, desde Zaragoza." bodyClass="bg-black text-white">
  <!-- NAV -->
  <header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-black/70 backdrop-blur">
    <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-5 text-sm">
      <a href="/" class="flex items-center gap-2 text-lg font-extrabold"><img src="/favicon.svg" alt="" class="h-6 w-6" />wave</a>
      <ul class="hidden gap-7 text-white/70 md:flex">
        {nav.map((n) => <li><a href="#" class="flex items-center gap-1 hover:text-white">{n}<span class="text-[9px]">▾</span></a></li>)}
      </ul>
      <div class="flex items-center gap-3">
        <a href="#" class="hidden text-white/70 hover:text-white sm:block">Login</a>
        <a href="#demo" class="rounded-md bg-wave px-4 py-1.5 font-semibold text-black transition hover:bg-white">Solicitar demo</a>
      </div>
    </nav>
  </header>

  <main class="overflow-x-hidden">
    <!-- HERO -->
    <section class="relative px-5 pt-36 text-center">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-[480px] bg-[radial-gradient(ellipse_at_top,rgba(33,174,192,0.25),transparent_65%)]"></div>
      <div class="relative mx-auto max-w-2xl">
        <h1 class="reveal text-4xl font-bold leading-tight tracking-tight md:text-6xl">Tecnología all-in-one diseñada para tu <span class="text-wave">evento</span></h1>
        <p class="reveal mx-auto mt-5 max-w-lg text-sm text-white/60 md:text-base">Vende entradas, controla el acceso, gestiona a tu equipo y conecta con tu público. Todo desde un único panel.</p>
        <div class="reveal mt-7 flex justify-center gap-3 text-sm font-semibold">
          <a href="#demo" class="rounded-md bg-white px-5 py-2.5 text-black transition hover:bg-wave">Solicitar información</a>
          <a href="#solucion" class="rounded-md bg-white/10 px-5 py-2.5 ring-1 ring-white/15 transition hover:bg-white/20">Ver demo</a>
        </div>
      </div>
      <div class="mx-auto mt-14 h-[3px] max-w-3xl rounded-full bg-gradient-to-r from-transparent via-wave to-transparent shadow-[0_0_30px_6px_rgba(33,174,192,0.6)]"></div>
    </section>

    <!-- MARQUEE -->
    <section class="mt-10 overflow-hidden border-y border-white/5 py-6" aria-label="Para quién es Wave">
      <div class="marquee flex w-max gap-12 text-lg font-bold text-white/30">
        {[...chips, ...chips].map((c) => <span class="whitespace-nowrap">{c}</span>)}
      </div>
    </section>

    <!-- DASHBOARD + BEAMS -->
    <section class="relative mx-auto max-w-4xl px-5 pt-20">
      <div class="absolute left-1/2 top-24 h-72 w-72 -translate-x-1/2 rounded-full bg-violet-600/20 blur-3xl"></div>
      <div class="reveal relative"><MockChart class="mx-auto" /></div>
      <svg viewBox="0 0 800 160" class="mx-auto -mt-1 h-32 w-full" fill="none" aria-hidden="true">
        <defs><linearGradient id="beam" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#21aec0" stop-opacity=".1"/><stop offset="1" stop-color="#21aec0"/></linearGradient></defs>
        {[60, 190, 320, 480, 610, 740].map((x) => <path d={`M${x} 0 C ${x} 90, 400 70, 400 160`} stroke="url(#beam)" stroke-width="1.5" />)}
      </svg>
      <p class="text-center text-[10px] font-semibold uppercase tracking-[0.2em] text-wave">Software para eventos</p>
      <h2 class="reveal mt-3 text-center text-3xl font-bold md:text-4xl">Domina cada beat en tus eventos</h2>
    </section>

    <!-- FIESTON -->
    <section class="mx-auto mt-24 max-w-5xl px-5">
      <div class="reveal grid overflow-hidden rounded-xl border border-white/10 bg-[#0b0b12] md:grid-cols-2">
        <div class="bg-gradient-to-br from-wave/10 to-transparent p-6"><MockPanel title="Preparar evento" items={preopen} /></div>
        <div class="bg-[radial-gradient(circle_at_top_right,rgba(124,92,255,0.25),transparent_60%)] p-7">
          <p class="text-[10px] font-semibold uppercase tracking-widest text-wave">Antes del evento</p>
          <h3 class="mt-2 text-xl font-bold">Un fiestón antes de abrir puertas</h3>
          <p class="mt-2 text-sm text-white/60">Configura todo con calma: entradas, precios, aforos, equipos y promoción. Cuando abras puertas, solo queda disfrutar.</p>
          <ul class="mt-4 space-y-2 text-xs text-white/70">
            {preopen.map((p) => <li class="flex items-center gap-2 rounded bg-white/5 px-3 py-2"><span class="h-1.5 w-1.5 rounded-full bg-wave"></span>{p}</li>)}
          </ul>
          <div class="mt-5 space-y-1 text-xs font-semibold text-wave"><a href="#">Descubre Wave Tickets →</a><br /><a href="#">Descubre Wave RRPP →</a></div>
        </div>
      </div>
    </section>

    <!-- SOLUCION INTEGRAL -->
    <section id="solucion" class="mx-auto mt-32 max-w-5xl px-5">
      <p class="text-center text-[10px] font-semibold uppercase tracking-[0.2em] text-wave">All-in-one software</p>
      <h2 class="reveal mt-3 text-center text-3xl font-bold md:text-4xl">Solución integral para una gestión revolucionaria</h2>
      <div class="mt-12 grid items-center gap-8 md:grid-cols-2">
        <div class="space-y-2">
          {solution.map(([t, d], i) => (
            <details open={i === 0} class="group rounded-lg border border-white/10 bg-white/[0.03] p-4">
              <summary class="flex cursor-pointer items-center gap-3 text-sm font-semibold">
                <span class={`h-2 w-2 rounded-full ${i === 0 ? "bg-red-500" : "bg-wave"}`}></span>{t}
              </summary>
              <p class="mt-2 pl-5 text-xs text-white/55">{d}</p>
            </details>
          ))}
        </div>
        <div class="reveal"><MockChart /></div>
      </div>
    </section>

    <!-- DESPEGAR -->
    <section class="mx-auto mt-28 max-w-5xl px-5">
      <div class="reveal relative grid items-center overflow-hidden rounded-xl border border-white/10 bg-gradient-to-br from-[#14102b] to-black p-8 md:grid-cols-2">
        <div>
          <span class="rounded-full bg-violet-500/20 px-3 py-1 text-[10px] font-semibold text-violet-300">Integraciones</span>
          <h3 class="mt-4 text-xl font-bold">¿Listo para despegar? Conecta y controla más apps de ventas y aumenta el alcance de tus eventos.</h3>
          <p class="mt-3 text-sm text-white/55">Conecta Wave con tu web, tus redes y tus pasarelas de pago para vender desde todos los canales.</p>
          <a href="#demo" class="mt-5 inline-block text-xs font-semibold text-wave">Descubre todas las integraciones →</a>
        </div>
        <div class="relative mx-auto mt-8 grid h-48 w-48 place-items-center md:mt-0">
          <div class="absolute inset-0 rounded-full border border-white/10"></div>
          <div class="absolute inset-6 rounded-full border border-white/10"></div>
          <div class="grid h-20 w-20 rotate-12 place-items-center rounded-2xl bg-gradient-to-br from-wave to-violet-500 text-4xl shadow-[0_0_50px_rgba(33,174,192,0.5)]">⚡</div>
          <i class="absolute left-2 top-10 h-3 w-3 rounded-full bg-green-400"></i><i class="absolute bottom-8 right-0 h-3 w-3 rounded-full bg-yellow-400"></i><i class="absolute right-4 top-6 h-3 w-3 rounded-full bg-violet-400"></i>
        </div>
      </div>
    </section>

    <!-- CREAMOS -->
    <section class="mx-auto mt-32 max-w-2xl px-5 text-center">
      <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-wave">Hecho desde dentro de la noche</p>
      <h2 class="reveal mt-3 text-3xl font-bold md:text-4xl">Creamos lo que necesitábamos y ahora también es tuyo</h2>
      <p class="mt-6 text-xs leading-relaxed text-white/55">Wave nace en Zaragoza, hablando con locales, promotoras y gente que sale cada fin de semana. No es una ticketera más: une la compra de la entrada con la comunidad que hace que una fiesta funcione.</p>
      <a href="#demo" class="mt-6 inline-block rounded-md bg-white px-5 py-2 text-xs font-semibold text-black transition hover:bg-wave">Solicitar demo</a>
    </section>

    <!-- INDUSTRIA -->
    <section class="mx-auto mt-32 max-w-5xl px-5">
      <p class="text-center text-[10px] font-semibold uppercase tracking-[0.2em] text-wave">Soluciones para tu negocio</p>
      <h2 class="reveal mt-3 text-center text-3xl font-bold md:text-4xl">Tecnología hecha por y para <span class="text-white/60">nuestra industria</span></h2>
      <div class="mt-10 grid gap-3 md:grid-cols-4">
        {industry.map(([t, d, e], i) => (
          <a href="#" class={`reveal group flex h-56 flex-col justify-between rounded-lg border border-white/10 p-4 transition hover:border-wave ${i === 0 ? "bg-gradient-to-b from-wave/20 to-black md:col-span-1" : "bg-white/[0.03]"}`}>
            <span class="text-2xl">{e}</span>
            <div><h3 class="font-bold">{t}</h3><p class="mt-1 text-xs text-white/55">{d}</p><span class="mt-2 inline-block text-xs text-wave opacity-0 transition group-hover:opacity-100">Saber más →</span></div>
          </a>
        ))}
      </div>
    </section>

    <!-- BACKSTAGE -->
    <section class="mx-auto mt-16 max-w-5xl px-5">
      <div class="reveal grid items-center overflow-hidden rounded-xl border border-white/10 bg-gradient-to-br from-[#14102b] to-black p-8 md:grid-cols-2">
        <div>
          <span class="rounded-full bg-violet-500/20 px-3 py-1 text-[10px] font-semibold text-violet-300">Soporte y formación</span>
          <h3 class="mt-4 text-xl font-bold">Más que soporte, somos el backstage del éxito</h3>
          <p class="mt-3 text-sm text-white/55">Te acompañamos en el montaje, la formación de tu equipo y cada noche de evento. Si algo falla un sábado, estamos ahí.</p>
          <a href="#demo" class="mt-5 inline-block text-xs font-semibold text-wave">Descubre nuestro acompañamiento →</a>
        </div>
        <div class="relative mx-auto mt-8 h-44 w-56 md:mt-0">
          {["💬", "📞", "🎧"].map((e, i) => <div class="absolute grid h-20 w-20 place-items-center rounded-2xl border border-white/10 bg-white/5 text-3xl backdrop-blur" style={`left:${i * 36}px; top:${i * 30}px; transform: rotate(${i * 8 - 8}deg)`}>{e}</div>)}
        </div>
      </div>
    </section>

    <!-- DIFERENCIA -->
    <section class="mx-auto mt-32 max-w-5xl px-5">
      <h2 class="reveal text-center text-3xl font-bold md:text-4xl">Marcamos la diferencia para que tú también lo hagas</h2>
      <div class="mt-10 grid gap-3 md:grid-cols-3">
        {diff.map(([i, t, d]) => (
          <div class="reveal rounded-lg border border-white/10 bg-white/[0.03] p-5">
            <div class="text-3xl text-wave">{i}</div>
            <h3 class="mt-6 text-sm font-bold">{t}</h3>
            <p class="mt-2 text-xs text-white/55">{d}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CASO DE EXITO -->
    <section class="mx-auto mt-32 max-w-5xl px-5">
      <p class="text-center text-[10px] font-semibold uppercase tracking-[0.2em] text-white/50">Los locales que confían en Wave</p>
      <h2 class="reveal mt-2 text-center text-sm font-semibold">Descubre el éxito de nuestros clientes</h2>
      <div class="reveal mt-6 grid gap-6 overflow-hidden rounded-xl border border-white/10 bg-gradient-to-br from-white/[0.05] to-transparent p-8 md:grid-cols-[1fr_1fr]">
        <div>
          <p class="text-2xl font-bold">Tu local, aquí</p>
          <ul class="mt-5 space-y-3 text-xs text-white/65">
            {["Centraliza la información en una sola plataforma", "Ajusta las campañas de marketing a tu público", "Digitaliza y mejora la operativa de tus recursos", "Reduce las colas en la puerta del evento"].map((t) => <li class="flex gap-2"><span class="text-wave">✓</span>{t}</li>)}
          </ul>
        </div>
        <button type="button" aria-label="Reproducir vídeo" class="group grid min-h-40 place-items-center rounded-lg bg-[radial-gradient(circle,rgba(33,174,192,0.25),transparent_70%)]">
          <span class="grid h-14 w-14 place-items-center rounded-full bg-white text-black transition group-hover:scale-110 group-hover:bg-wave">▶</span>
        </button>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto mt-32 grid max-w-5xl gap-8 px-5 md:grid-cols-[1fr_1.4fr]">
      <div>
        <h2 class="text-3xl font-bold">FAQs</h2>
        <p class="mt-3 max-w-xs text-xs text-white/55">Si ya has visto nuestras preguntas frecuentes y necesitas algo más, escríbenos. Estamos para ayudarte.</p>
      </div>
      <div class="space-y-2">
        {faqs.map(([q, a], i) => (
          <details open={i === 0} class="rounded-lg border border-white/10 bg-white/[0.03] p-4">
            <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold">{q}<span class="faq-icon text-wave transition">+</span></summary>
            <p class="mt-3 text-xs leading-relaxed text-white/55">{a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA FINAL -->
    <section id="demo" class="relative mt-32 overflow-hidden px-5 py-28 text-center">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(33,174,192,0.45),transparent_55%),radial-gradient(ellipse_at_top_left,rgba(124,92,255,0.45),transparent_55%)]"></div>
      <div class="relative">
        <p class="flex items-center justify-center gap-2 text-sm font-extrabold"><img src="/favicon.svg" alt="" class="h-5 w-5" />wave</p>
        <h2 class="reveal mx-auto mt-4 max-w-md text-3xl font-bold md:text-4xl">La flexibilidad que te permite trabajar a tu manera.</h2>
        <p class="mx-auto mt-4 max-w-sm text-xs text-white/60">Cuéntanos cómo trabajas y lo adaptamos a tu local, tu promotora o tu evento.</p>
        <a href="mailto:hola@siemprewave.es" class="mt-7 inline-block rounded-md bg-white px-6 py-2.5 text-xs font-semibold text-black transition hover:bg-wave">Solicitar demo</a>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="border-t border-white/10 px-5 pt-14 pb-8 text-xs text-white/55">
    <div class="mx-auto grid max-w-5xl gap-10 md:grid-cols-[1.2fr_repeat(4,1fr)]">
      <div>
        <p class="font-semibold text-white">Descárgate la app</p>
        <div class="mt-3 flex gap-2">
          <a href="#" class="rounded-md border border-white/20 px-3 py-1.5"> App Store</a>
          <a href="#" class="rounded-md border border-white/20 px-3 py-1.5">Google Play</a>
        </div>
      </div>
      {cols.map(([h, links]) => (
        <div>
          <p class="font-semibold text-white">{h}</p>
          <ul class="mt-3 space-y-2">{(links as string[]).map((l) => <li><a href="#" class="hover:text-white">{l}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="mx-auto mt-10 flex max-w-5xl flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-6">
      <div class="flex gap-4"><a href="#">Legal</a><a href="#">Privacidad</a><a href="#">Cookies</a><a href="#">Términos y condiciones</a></div>
      <div class="flex items-center gap-3">
        {["IG", "TT", "YT", "in"].map((s) => <a href="#" class="grid h-7 w-7 place-items-center rounded border border-white/15 text-[10px]">{s}</a>)}
        <span class="rounded border border-white/15 px-3 py-1">Español ▾</span>
      </div>
    </div>
    <p class="mx-auto mt-8 max-w-5xl">© {new Date().getFullYear()} Wave · siemprewave.es · Hecho en Zaragoza</p>
  </footer>
</Base>
