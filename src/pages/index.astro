---
import Fx from "../layouts/Fx.astro";
import FeatureMock from "../components/FeatureMock.astro";

const services = [
  ["Entradas", "Vende antes, vende más", "Tipos de entrada, precios por fases y códigos promocionales.", ["Tipos de entrada con precios por fases", "Hora límite de acceso y códigos de desbloqueo", "Cuenta atrás y avisos de pocas entradas"], "tickets"],
  ["Listas", "Listas a tu manera", "Gratis o de pago, con cupos por RRPP.", ["Listas gratis, de pago y con código", "Cupos y horarios por lista", "Mide qué RRPP llena cada una"], "lists"],
  ["Reservados", "Mesas que no se pierden", "Tus clientes eligen mesa en el plano de tu sala.", ["Plano interactivo de tu sala", "Carta de botellas al reservar", "Reservas sin llamadas ni mensajes"], "tables"],
  ["Pases VIP", "Tus mejores clientes, primero", "Tarjetas y pases de temporada.", ["Pases de temporada y tarjetas VIP", "Acceso con QR desde el móvil", "Ventajas que defines tú"], "vip"],
  ["RRPP", "Un equipo que vende solo", "Un enlace por RRPP y comisiones automáticas.", ["Enlace y código propios", "Comisiones calculadas por venta", "Ranking de rendimiento del equipo"], "rrpp"],
  ["CRM", "Conoce a quien vuelve", "Tu base de datos privada de clientes.", ["Historial, gasto y frecuencia", "Segmenta y escribe a tu público", "Los datos son tuyos"], "crm"],
  ["Apple / Google Pay", "Pagar en un toque", "Pago rápido y entrada en la cartera del móvil.", ["Apple Pay, Google Pay y tarjeta", "Entrada guardada en el Wallet", "Menos pasos, más compras"], "pay"],
  ["App de check-in", "Accesos sin colas", "Escanea con cualquier móvil.", ["Escaneo con la cámara del móvil", "Aforo en directo", "Para todo tu equipo de puerta"], "checkin"],
  ["Estadísticas", "Decide con datos", "Ventas y accesos de cada noche.", ["Ventas por canal y por RRPP", "Accesos y aforo por hora", "Informe al cerrar la noche"], "stats"],
];
const faqs = [
  ["¿Tengo que cambiar mi forma de trabajar?", "No. Wave se adapta a cómo trabajas hoy: entradas, listas, mesas y RRPP. En la demo lo configuramos con tu caso real."],
  ["¿Puedo usar Wave solo para la venta online?", "Sí. Puedes empezar solo con la tienda de entradas y añadir taquilla, RRPP o reservas cuando quieras."],
  ["¿Cuánto cuesta y qué recibe mi local?", "Te lo explicamos en la demo con números claros: qué cobra Wave, qué cobra el procesador de pagos y cuánto recibe tu local por entrada."],
  ["¿Puedo traer mi base de datos de clientes?", "Lo vemos contigo en la demo y te decimos cómo hacerlo con tus datos."],
  ["¿Mis clientes verán mi marca o la de Wave?", "La tuya. La tienda, los correos y la entrada en el Wallet salen con tu nombre, tus colores y tus formas."],
];
const swA = [["#21aec0", "Turquesa"], ["#8b5cf6", "Violeta"], ["#f97316", "Naranja"], ["#a3e635", "Lima"], ["#f43f5e", "Coral"]];
const swB = [["#0f0f12", "Noche"], ["#ffffff", "Blanco"], ["#1b1030", "Violeta oscuro"], ["#0e1c1a", "Verde noche"]];
const qr = (n: number) => Array.from({ length: 49 }, (_, i) => ((i * 7 + n * 13) % 5 < 2) || [0, 1, 7, 6, 8, 42, 48, 41, 43, 14, 35].includes(i));
const tablePos = [[40, 54], [100, 54], [160, 54], [220, 54], [70, 94], [130, 94], [190, 94]];
const appWords = ["Get the app", "Descarga Wave"];
const phases = [
  ["Antes", "Vende antes de abrir puertas", [["Entradas por fases", "3 tipos"], ["Listas de RRPP", "activas"], ["Tienda online", "publicada"], ["Reservados", "con plano"]]],
  ["Durante", "Controla con la sala llena", [["Accesos escaneados", "en directo"], ["Aforo", "por zona"], ["Taquilla", "sincronizada"], ["Incidencias", "en el móvil"]]],
  ["Después", "Aprende de cada noche", [["Informe de ventas", "al cerrar"], ["Rendimiento RRPP", "por persona"], ["Clientes nuevos", "a tu CRM"], ["Siguiente fiesta", "con tu público"]]],
];
const words = ["Discotecas", "Promotoras", "Beach Clubs", "Festivales", "Lounges", "Pubs"];
const links = [["Inicio", "/"], ["Discotecas", "/discotecas"], ["Promotores", "/promotores"], ["Beach Clubs", "/beach-clubs"], ["Festivales", "/festivales"], ["Pide tu demo", "#demo"]];
const swatches = [["#21aec0", "Turquesa"], ["#8b5cf6", "Violeta"], ["#f97316", "Naranja"], ["#a3e635", "Lima"], ["#f43f5e", "Coral"]];
---
<Fx title="Wave · Software para locales de ocio nocturno" description="Entradas, listas, reservados, RRPP, CRM y check-in con tu marca. Wave para discotecas, promotoras, beach clubs y festivales.">
  <!-- Preloader -->
  <div class="fx-preloader" aria-hidden="true"><div class="fx-pre-title"><h1>Wave</h1></div></div>
  <div class="fx-split" aria-hidden="true"><div class="fx-pre-title"><h1>Wave</h1></div></div>
  <div class="fx-tags" aria-hidden="true">
    <div class="fx-tag fx-tag-1 mono"><p>Entradas</p></div>
    <div class="fx-tag fx-tag-2 mono"><p>RRPP</p></div>
    <div class="fx-tag fx-tag-3 mono"><p>Check-in</p></div>
  </div>

  <!-- Nav -->
  <nav class="fx-nav" aria-label="Principal">
    <a href="/" class="fx-logo"><img src="/favicon.svg" alt="" />Wave</a>
    <div class="fx-nav-right">
      <a class="fx-nav-cta mono" href="#demo">Solicita una demo</a>
      <button type="button" class="fx-toggler mono" aria-expanded="false" aria-controls="fx-menu"><span class="lbl">Menú</span><span class="lbl">Cerrar</span></button>
    </div>
  </nav>
  <div class="fx-menu" id="fx-menu">
    <div class="fx-menu-info">
      <div><p class="mono">Wave</p><p class="mono">Ticketing + comunidad</p><p class="mono">Zaragoza</p></div>
      <div><p class="mono">Habla con nosotros</p><p class="mono">hola@siemprewave.es</p></div>
      <div><p class="mono">Para locales</p><p class="mono">Discotecas · Promotoras · Beach Clubs · Festivales</p></div>
    </div>
    <div class="fx-links">
      <div class="fx-hi"></div>
      {links.map(([t, h]) => <div class="fx-menu-link"><a href={h}><span>{t}</span></a></div>)}
    </div>
  </div>

  <main>
    <!-- Hero -->
    <section class="fx-hero" data-nav="dark">
      <h1 class="fx-hero-title" data-split="words" data-delay="0.6">Wave</h1>
      <div class="fx-hero-foot mono">
        <div>
          <p data-split="lines" data-delay="0.9">Software para locales de ocio nocturno</p>
          <p data-split="lines" data-delay="1">Entradas · RRPP · CRM</p>
        </div>
        <div><p data-split="lines" data-delay="1.1">© Wave · Zaragoza</p></div>
      </div>
    </section>

    <!-- Partículas -->
    <section class="fx-particles" data-nav="light">
      <canvas id="fx-particle-canvas" aria-label="Logotipo de Wave hecho de partículas"></canvas>
      <div class="fx-particles-copy">
        <h2 class="fx-particles-title" data-split="lines" data-scroll="true">Más que un software de gestión</h2>
        <p class="fx-particles-lead mono" data-split="lines" data-scroll="true" data-delay="0.2">Una ticketera con comunidad: tu público descubre, compra y vuelve.</p>
      </div>
      <p class="fx-scroll-hint mono">Mueve el cursor</p>
    </section>

    <!-- Servicios -->
    <section class="svc" id="servicios" data-nav="dark">
      <div class="wrap">
        <div class="sec-head">
          <h2 data-split="lines" data-scroll="true">Todo lo que necesita tu local</h2>
          <p data-split="lines" data-scroll="true" data-delay="0.15">Nueve herramientas en un único panel. Abre cada una para ver cómo funciona.</p>
        </div>
        <ul class="svc-list">
          {services.map(([t, h, d, pts, kind], i) => (
            <li class="svc-item">
              <button type="button" class="svc-row" aria-expanded="false" aria-controls={`svc-${i}`} data-title={t} data-desc={d} data-cursor>
                <span class="mono">{String(i + 1).padStart(2, "0")}</span>
                <h3>{t}</h3>
                <span class="d">{d}</span>
                <span class="svc-plus" aria-hidden="true"></span>
              </button>
              <div class="svc-more" id={`svc-${i}`}>
                <div>
                  <div class="svc-body">
                    <div><h4>{h}</h4><ul>{(pts as string[]).map((p) => <li>{p}</li>)}</ul></div>
                    <FeatureMock kind={kind} />
                  </div>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <div class="svc-preview" aria-hidden="true">
      <p class="mono" data-pv-kicker>01 / 09</p>
      <h4 data-pv-title>Entradas</h4>
      <p data-pv-desc></p>
      <div class="bars"><i data-pv-bar></i><i data-pv-bar></i><i data-pv-bar></i></div>
    </div>

    <!-- Marca blanca -->
    <section class="wl" id="marca-blanca" data-nav="light">
      <div class="wrap">
        <div class="wl-head">
          <div>
            <p class="mono" style="color:var(--l)">Marca blanca</p>
            <h2 data-split="lines" data-scroll="true">Tu marca. De verdad.</h2>
          </div>
          <p class="wl-lead">Tu web, tus correos y la entrada en el Wallet salen con tu nombre, tus colores y tus formas. Cambia algo a la izquierda y míralo en los tres sitios.</p>
        </div>
        <div class="wl-stage" id="wl-root">
          <div class="wl-panel">
            <div class="f"><label class="mono" for="wl-brand">Nombre de tu local</label><input id="wl-brand" type="text" value="Tu Local" maxlength="22" autocomplete="off" /></div>
            <div class="f"><span class="mono">Color de resalte</span><div class="wl-sw">{swA.map(([c, n], i) => <button type="button" style={`--c:${c}`} data-accent={c} aria-label={n} aria-pressed={i === 0 ? "true" : "false"}></button>)}</div></div>
            <div class="f"><span class="mono">Color de fondo</span><div class="wl-sw">{swB.map(([c, n], i) => <button type="button" style={`--c:${c}`} data-bg={c} aria-label={n} aria-pressed={i === 0 ? "true" : "false"}></button>)}</div></div>
            <div class="f"><label class="mono" for="wl-radius">Radio de las esquinas · <span data-radius-out>14 px</span></label><input id="wl-radius" type="range" min="0" max="28" value="14" /></div>
            <div class="wl-switch"><label class="mono" for="wl-map">Mapa de tu sala</label><input id="wl-map" type="checkbox" checked /></div>
          </div>
          <div class="wl-view">
            <div class="wl-tabs mono" role="tablist">
              <button type="button" role="tab" data-wl-tab="web" aria-selected="true">Tu web</button>
              <button type="button" role="tab" data-wl-tab="mail" aria-selected="false">Tus correos</button>
              <button type="button" role="tab" data-wl-tab="wallet" aria-selected="false">Tu Wallet</button>
            </div>

            <div class="wl-pane" data-wl-pane="web">
              <div class="wl-browser">
                <div class="wl-bar mono"><i></i><i></i><i></i><span>tulocal.com/entradas</span></div>
                <div class="wl-site">
                  <div>
                    <div class="wl-brand"><span class="wl-logo" data-initial>T</span><b data-brand>Tu Local</b></div>
                    <div class="wl-links mono"><span>Agenda</span><span>Reservas</span><span>Contacto</span></div>
                    <div class="wl-hero"><h3>La noche es <span>de <em style="font-style:normal" data-brand>Tu Local</em></span></h3><p>Compra aquí tu entrada o elige tu mesa. Sin salir de nuestra web.</p></div>
                  </div>
                  <div class="wl-widget" aria-label="Tienda de entradas integrada en la web del local">
                    <div class="ev"><i></i><div><b>Sábado de <span data-brand>Tu Local</span></b><small>Sáb 23:30 · Tu sala</small></div></div>
                    <div class="wl-map" aria-label="Plano de la sala">
                      <svg viewBox="0 0 260 120" role="group">
                        <rect class="stage" x="88" y="6" width="84" height="16" rx="4"></rect>
                        {tablePos.map(([x, y], i) => (<><circle class="wl-table" data-n={i + 1} cx={x} cy={y} r="14" tabindex="0" role="button" aria-label={`Mesa ${i + 1}`}></circle><text x={x} y={y + 3}>{i + 1}</text></>))}
                      </svg>
                      <small>Toca una mesa para reservarla · 150 €</small>
                    </div>
                    <div class="wl-ticket"><div><b>Entrada general</b><br /><small>12 €</small></div><div class="qty"><button type="button" data-step="general:-1" aria-label="Quitar una">−</button><span data-q-general>1</span><button type="button" data-step="general:1" aria-label="Añadir una">+</button></div></div>
                    <div class="wl-ticket"><div><b>Entrada + copa</b><br /><small>18 €</small></div><div class="qty"><button type="button" data-step="copa:-1" aria-label="Quitar una">−</button><span data-q-copa>0</span><button type="button" data-step="copa:1" aria-label="Añadir una">+</button></div></div>
                    <div class="wl-buy"><div><small>Total</small><br /><b data-total>12 €</b></div><button type="button" data-buy>Comprar</button></div>
                    <div class="wl-toast" role="status">Es una demo: aquí se abriría el pago</div>
                  </div>
                </div>
              </div>
              <p class="wl-note mono">La tienda se integra en tu web y se adapta a tu diseño.</p>
            </div>

            <div class="wl-pane" data-wl-pane="mail" hidden>
              <div class="wl-mail">
                <div class="wl-mailhead"><b><span data-brand>Tu Local</span> · tus entradas ✓</b><small>De: entradas@tulocal.com</small></div>
                <div class="wl-mailbody">
                  <div class="wl-mailcard">
                    <div class="top"><span class="wl-logo" data-initial>T</span><b style="font-family:var(--f-h);font-weight:400;font-size:1.4rem;text-transform:uppercase" data-brand>Tu Local</b></div>
                    <div class="in">
                      <h4>¡Nos vemos el sábado!</h4>
                      <ul data-order></ul>
                      <div class="qrbox"><div class="qr" aria-hidden="true">{qr(5).map((on) => <i class={on ? "on" : ""}></i>)}</div><div><small>Total</small><br /><b data-total>12 €</b></div></div>
                      <span class="btn2">Ver mis entradas</span>
                      <p class="foot">Enviado por <span data-brand>Tu Local</span> con tecnología Wave</p>
                    </div>
                  </div>
                </div>
              </div>
              <p class="wl-note mono">Los correos de compra salen con tu nombre, tus colores y tus formas.</p>
            </div>

            <div class="wl-pane" data-wl-pane="wallet" hidden>
              <div class="wl-wallet">
                <div class="wl-phone">
                  <p class="mono">Apple Wallet</p>
                  <div class="pass apple">
                    <div class="row"><b style="font-family:var(--f-h);font-weight:400;text-transform:uppercase;font-size:1.2rem" data-brand>Tu Local</b><small>Sáb 23:30</small></div>
                    <h4>Entrada<br />Sábado</h4>
                    <div class="qrw"><div class="qr" aria-hidden="true">{qr(8).map((on) => <i class={on ? "on" : ""}></i>)}</div></div>
                    <small>Acceso válido para 1 persona</small>
                  </div>
                </div>
                <div class="wl-phone">
                  <p class="mono">Google Wallet</p>
                  <div class="pass google">
                    <div class="row"><div class="wl-brand"><span class="wl-logo" data-initial>T</span><b data-brand>Tu Local</b></div><small>Sáb 23:30</small></div>
                    <h4>Entrada<br />Sábado</h4>
                    <div class="qrw"><div class="qr" aria-hidden="true">{qr(11).map((on) => <i class={on ? "on" : ""}></i>)}</div></div>
                    <small>Acceso válido para 1 persona</small>
                  </div>
                </div>
              </div>
              <p class="wl-note mono">La entrada siempre en su móvil, en Apple Wallet y Google Wallet.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Panel en ordenador y móvil -->
    <section class="dev" data-nav="dark">
      <div class="wrap dev-grid">
        <div>
          <p class="mono">Una herramienta en constante evolución</p>
          <h2 data-split="lines" data-scroll="true" style="margin-top:.8rem">Tu panel. En el ordenador y en el móvil.</h2>
          <p class="sm">Maneja eventos, ventas y accesos desde donde estés. Lo que haces en el ordenador lo ve tu equipo de puerta en el móvil, al instante.</p>
          <p class="ex mono">Datos de ejemplo</p>
        </div>
        <div class="dev-devices" aria-hidden="true">
          <div class="laptop">
            <div class="scr">
              <div class="tiles">
                <div><small class="mono">Entradas</small><b data-count="1248">0</b></div>
                <div><small class="mono">Aforo</small><b data-count="86" data-suffix=" %">0</b></div>
                <div><small class="mono">Ingresos</small><b data-count="18400" data-suffix=" €">0</b></div>
              </div>
              <div class="bars">{[28, 40, 34, 52, 46, 68, 60, 82, 70, 92, 80, 100].map((h) => <i style={`height:${h}%`}></i>)}</div>
            </div>
          </div>
          <div class="laptop-base"></div>
          <div class="phone">
            <div class="scr">
              <p class="mono">Check-in</p>
              <div class="fm-frame"><i class="line"></i></div>
              <span class="okc mono">Acceso correcto</span>
              <div class="log">{[["Entrada general", "23:41"], ["Lista RRPP", "23:40"], ["Reservado · mesa 4", "23:38"]].map(([a, b]) => <div><span>{a}</span><span>{b}</span></div>)}</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Fases -->
    <section class="phases" data-nav="dark" aria-label="Antes, durante y después del evento">
      <div class="phases-in">
        <div class="phase-words" aria-hidden="true">{phases.map(([w]) => <span class="phase-word">{w}</span>)}</div>
        <div class="phase-stage">
          {phases.map(([w, t, rows]) => (
            <article class="phase-card">
              <div><p class="mono" style="color:var(--l)">{w} del evento</p><h3 style="margin-top:.8rem">{t}</h3></div>
              <ul>{(rows as string[][]).map(([a, b]) => <li><span>{a}</span><b class="mono">{b}</b></li>)}</ul>
            </article>
          ))}
        </div>
      </div>
      <div class="phase-progress" aria-hidden="true"><i></i></div>
    </section>

    <!-- Marquesinas -->
    <section class="mq" data-nav="light" aria-label="Para quién es Wave">
      {[0, 1].map((r) => (
        <div class="mq-row"><div class="mq-track">{[...words, ...words].map((w, i) => <><span>{w}</span><span class="dot">✦</span></>)}</div></div>
      ))}
    </section>

    <!-- Soporte -->
    <section class="sup" id="soporte" data-nav="dark">
      <div class="wrap sup-grid">
        <h2 data-split="lines" data-scroll="true">Trato humano y cercano</h2>
        <div>
          <p class="big" data-split="lines" data-scroll="true">Estamos contigo <em>cuando lo necesites</em>: en el montaje, en la formación de tu equipo y la noche del evento.</p>
          <p class="sm">Wave no es solo un software de gestión. Detrás hay un equipo de la noche que te acompaña, resuelve dudas y te ayuda a sacar partido a cada herramienta.</p>
        </div>
        <h2 data-split="lines" data-scroll="true">Una app y una comunidad</h2>
        <div>
          <p class="big" data-split="lines" data-scroll="true">Tu público ve <em>qué planes hay</em>, quién va y compra la entrada sin salir de la app.</p>
          <p class="sm">Zona Fiesta, Match, música y fotos de cada noche: la comunidad de Wave ayuda a promocionar tus eventos y a vender antes.</p>
          <div class="links"><a href="/discotecas">Discotecas</a><a href="/promotores">Promotores</a><a href="/beach-clubs">Beach Clubs</a><a href="/festivales">Festivales</a></div>
        </div>
      </div>
    </section>

    <!-- Franja demo + FAQ -->
    <a class="strip" href="#demo" data-nav="dark" aria-label="Prueba nuestra demo">
      <div class="mq-track">{[...Array(8)].map(() => <><span>Prueba nuestra demo</span><span class="dot">✦</span></>)}</div>
    </a>
    <section class="faq" id="faq" data-nav="light">
      <div class="wrap faq-grid">
        <h2 data-split="lines" data-scroll="true">Preguntas</h2>
        <div class="faq-list">
          {faqs.map(([q, a], i) => (
            <div class={`faq-item${i === 0 ? " is-open" : ""}`}>
              <button type="button" class="faq-q" aria-expanded={i === 0 ? "true" : "false"}><span>{q}</span><span class="svc-plus" aria-hidden="true"></span></button>
              <div class="faq-a"><div><p>{a}</p></div></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Demo -->
    <section class="demo" id="demo" data-nav="dark">
      <div class="wrap demo-grid">
        <h2 data-split="lines" data-scroll="true">Solicita ya tu demo</h2>
        <form id="demo-form">
          <label><span class="mono">Email</span><input id="demo-email" type="email" required autocomplete="email" placeholder="tu@local.com" /></label>
          <label><span class="mono">Teléfono</span><input id="demo-tel" type="tel" required autocomplete="tel" placeholder="600 000 000" /></label>
          <button class="btn" type="submit"><span>Solicitar</span><span aria-hidden="true">→</span></button>
          <p class="note">Al enviar se abre tu correo con los datos listos para mandarnos.</p>
        </form>
      </div>
    </section>
  </main>

  <footer class="fx-footer" data-nav="light">
    <a class="strip dark" href="#" aria-label="Descarga la app" style="margin-bottom:clamp(2rem,5vw,4rem)">
      <div class="mq-track">{[...Array(8)].map(() => <>{appWords.map((w) => <><span>{w}</span><span class="dot">✦</span></>)}</>)}</div>
    </a>
    <div class="wrap">
      <div class="fx-foot-cols mono">
        <div><p>Wave</p><a href="/">Inicio</a><a href="#servicios">Herramientas</a><a href="#demo">Demo</a></div>
        <div><p>Sectores</p><a href="/discotecas">Discotecas</a><a href="/promotores">Promotores</a><a href="/beach-clubs">Beach Clubs</a><a href="/festivales">Festivales</a></div>
        <div><p>Síguenos</p><a href="#">Instagram</a><a href="#">TikTok</a></div>
        <div><p>Legal</p><a href="#">Términos y condiciones</a><a href="#">Privacidad</a><a href="#">Cookies</a></div>
      </div>
      <p class="fx-foot-word" aria-hidden="true">Wave</p>
