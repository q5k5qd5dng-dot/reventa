  <script>
    import "../scripts/fx";
  </script>
  <script>
    const nav = document.getElementById("nav");
    const logo = document.getElementById("logo");
    const links = document.getElementById("links");
    const login = document.getElementById("login");
    const sell = document.getElementById("sell-link");
    const onScroll = () => {
      const on = window.scrollY > 40;
      nav?.classList.toggle("bg-white/90", on);
      nav?.classList.toggle("backdrop-blur-xl", on);
      nav?.classList.toggle("shadow-sm", on);
      for (const el of [logo, links, sell]) {
        el?.classList.toggle("text-white", !on);
        el?.classList.toggle("text-ink", on);
        el?.classList.toggle("text-white/90", !on && el === links);
      }
      login?.classList.toggle("text-white", !on);
      login?.classList.toggle("border-white/50", !on);
      login?.classList.toggle("text-violet-700", on);
      login?.classList.toggle("border-violet-300", on);
    };
    onScroll();
    addEventListener("scroll", onScroll, { passive: true });

    const q = document.getElementById("q") as HTMLInputElement | null;
    const cards = [...document.querySelectorAll<HTMLElement>(".ev")];
    const tabs = [...document.querySelectorAll<HTMLElement>(".cat")];
    const count = document.getElementById("count");
    const empty = document.getElementById("empty");
    let cat = "all";
    const apply = () => {
      const term = (q?.value ?? "").trim().toLowerCase();
      let n = 0;
      for (const c of cards) {
        const ok = (cat === "all" || c.dataset.cat === cat) && (!term || (c.dataset.s ?? "").includes(term));
        c.classList.toggle("hidden", !ok);
        if (ok) n++;
      }
      if (count) count.textContent = `${n} evento${n === 1 ? "" : "s"}`;
      empty?.classList.toggle("hidden", n > 0);
      dispatchEvent(new CustomEvent("ht:filtered"));
    };
    tabs.forEach((t) =>
      t.addEventListener("click", () => {
        cat = t.dataset.cat ?? "all";
        tabs.forEach((x) => x.setAttribute("aria-selected", String(x === t)));
        apply();
      }),
    );
    q?.addEventListener("input", apply);
    document.getElementById("search")?.addEventListener("submit", () => document.getElementById("eventos")?.scrollIntoView({ behavior: "smooth" }));
    document.querySelectorAll<HTMLElement>(".quick").forEach((b) =>
      b.addEventListener("click", () => {
        if (q) q.value = b.dataset.q ?? "";
        apply();
        document.getElementById("eventos")?.scrollIntoView({ behavior: "smooth" });
      }),
    );
    apply();
  </script>
