---
import fs from "node:fs";
import path from "node:path";
import Replica from "../layouts/Replica.astro";
import Sell from "../views/r/Sell.astro";
import { events, fechaLarga } from "../data/events";
import { extra } from "../data/extra";
import art from "../data/art.json";
import { brand } from "../brand";

const fecha = fechaLarga;
const b64 = (f: string) => `url(data:image/webp;base64,${fs.readFileSync(path.join(process.cwd(), "src/assets/art", f + ".webp")).toString("base64")})`;
const cssVars = events.map((e) => `--art-${e.id}:${b64(e.id)};--tint-${e.id}:${(art as any)[e.id].tint};`).join("") + `--seats-wide:${b64("seats-wide")};--seats-tall:${b64("seats-tall")};`;
const css = `:root{${cssVars}}`;

const featured = [
  { t: "Copa de Europa 2026/27", s: "Las mejores noches del fútbol europeo, con entradas verificadas y entrega garantizada.", ev: events[6] },
  { t: "Karol Vega · Gira Verano", s: "Su gira llega a los estadios. Encuentra tus entradas antes de que vuelen.", ev: events[0] },
  { t: "Noche Techno · Sala Apolo", s: "La sesión de madrugada más esperada de Barcelona. Pocas entradas, mucho ruido.", ev: events[4] },
  { t: "El Rey de la Escena", s: "El musical que ha llenado teatros de toda Europa llega por fin a Zaragoza.", ev: events[5] },
  { t: "Duro Festival XXI", s: "Dos días, cuatro escenarios y lo mejor del techno y el house europeo.", ev: events[1] },
];
const sedes = [
  { n: "Estadio Metropolitano", c: "Madrid", ev: events[0], z: 190, p: "50% 70%" },
  { n: "Sala Apolo", c: "Barcelona", ev: events[4], z: 170, p: "50% 58%" },
  { n: "Can Guitet", c: "Barcelona", ev: events[1], z: 180, p: "50% 62%" },
  { n: "Palau Sant Jordi", c: "Barcelona", ev: events[3], z: 180, p: "50% 70%" },
  { n: "Teatro Principal", c: "Zaragoza", ev: events[5], z: 170, p: "50% 45%" },
  { n: "Estadio Central", c: "Bilbao", ev: events[6], z: 170, p: "50% 50%" },
];
const reviews = [
  { n: "Marta", t: "Pensé que sería complicado conseguir entradas para un concierto agotado, pero lo encontré en cinco minutos. La entrada llegó al momento y entré sin ningún problema. Muy recomendable." },
  { n: "Pablo", t: "Vendí dos entradas que no podía usar. Las compraron esa misma tarde y el dinero me llegó automáticamente tras el evento. Me gustó mucho que fuera todo tan transparente." },
  { n: "Lucía", t: "Me escribieron enseguida cuando tuve una duda sobre mi compra. Se agradece que haya gente real detrás. Volveré a usarlo seguro para el próximo festival." },
];
const cities = ["Madrid", "Barcelona", "Bilbao", "Ibiza", "Valencia", "Sevilla", "Málaga", "A Coruña", "Donostia", "Zaragoza", "Tenerife", "Murcia"];
---

<Replica>
  <style slot="head" is:inline set:html={css}></style>
  <!-- HEADER -->
  <header id="hdr" data-hdr="home" class="fixed inset-x-0 top-0 z-[100]">
    <div class="mx-auto flex max-w-[1650px] items-center justify-between px-6 py-4 sm:py-6 min-[1720px]:px-0">
      <a href="#/" id="logo" class="hl logo-word text-[2.1rem] sm:text-[3.4rem]" aria-label={`${brand.name}, inicio`}>handticket</a>
      <nav class="relative flex items-center gap-2 sm:gap-3" aria-label="Principal">
        <div class="hout flex items-center gap-2 sm:gap-3">
          <a href="#/vender" class="hl hidden px-4 py-3 text-base transition hover:opacity-70 md:block">Cómo funciona</a>
          <button id="login-btn" class="hb whitespace-nowrap rounded-lg border px-4 py-2.5 text-sm transition sm:px-5 sm:py-3 sm:text-base">Iniciar sesión</button>
          <button id="sell-btn" class="hs hidden items-center gap-2 rounded-lg px-5 py-3 text-base transition sm:inline-flex"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm5 11h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/></svg>Vender entrada</button>
        </div>
        <div class="hmin hidden"><a id="hmin-a" href="#/vender/anuncio" class="pill">Ver todo</a><a href="#/ayuda">Ayuda</a></div>
        <div class="hin hidden items-center gap-1 sm:gap-3">
          <button id="open-search" class="hl grid h-11 w-11 place-items-center rounded-full transition hover:bg-black/5" aria-label="Buscar"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.3-4.3"/></svg></button>
          <a href="#/mis-entradas" class="hl hidden px-2 py-3 text-base transition hover:opacity-70 md:block">Mis entradas</a>
          <a href="#/mis-anuncios" class="hl hidden px-2 py-3 text-base transition hover:opacity-70 md:block">Mis anuncios</a>
          <button id="avatar" class="grid h-11 w-11 place-items-center rounded-full text-lg font-medium text-white" aria-haspopup="menu" aria-expanded="false" aria-label="Mi cuenta">?</button>
          <button id="menu-btn" class="hl grid h-11 w-11 place-items-center rounded-full transition hover:bg-black/5" aria-haspopup="menu" aria-expanded="false" aria-label="Menú"><svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
          <button id="sell-btn2" class="hs2 hidden items-center gap-2 rounded-xl bg-ink px-5 py-3.5 text-base font-medium text-white transition hover:bg-black sm:inline-flex"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm5 11h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/></svg>Vender entrada</button>
        </div>
        <div id="acc-menu" class="absolute right-0 top-full z-[120] mt-3 hidden w-[19rem] overflow-hidden rounded-3xl bg-white p-3 text-ink shadow-[0_24px_60px_-16px_rgba(0,0,0,0.35)] ring-1 ring-black/5" role="menu">
          <div class="flex items-center gap-4 px-2 pb-4 pt-2"><span id="acc-av" class="grid h-14 w-14 shrink-0 place-items-center rounded-full text-2xl text-white">?</span><div class="min-w-0"><p id="acc-name" class="truncate text-lg font-semibold"></p><p id="acc-email" class="truncate text-sm text-sub"></p></div></div>
          <div class="border-t border-line pt-2">
            <button role="menuitem" id="m-profile" class="flex w-full items-center gap-4 rounded-xl px-3 py-3.5 text-left text-[1.02rem] transition hover:bg-soft"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4-6 8-6s7 2 8 6"/></svg>Perfil</button>
            <button role="menuitem" id="m-help" class="flex w-full items-center gap-4 rounded-xl px-3 py-3.5 text-left text-[1.02rem] transition hover:bg-soft"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14v-2a8 8 0 0116 0v2M4 14a2 2 0 012-2h1v6H6a2 2 0 01-2-2v-2zM20 14a2 2 0 00-2-2h-1v6h1a2 2 0 002-2v-2zM18 18c0 2-2 3-5 3"/></svg>Centro de ayuda</button>
          </div>
          <div class="mt-1 border-t border-line pt-2"><button role="menuitem" id="logout" class="flex w-full items-center gap-4 rounded-xl px-3 py-3.5 text-left text-[1.02rem] text-[#d92d20] transition hover:bg-[#d92d20]/5"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4H6a2 2 0 00-2 2v12a2 2 0 002 2h3M16 8l4 4-4 4M20 12H9"/></svg>Cerrar sesión</button></div>
        </div>
      </nav>
    </div>
  </header>

  <div id="pages">
  <main id="v-home" class="view" data-view="home">
    <!-- HERO -->
    <section id="hero" class="hero-bg relative overflow-x-clip pt-28 text-center text-white sm:pt-36 lg:pt-[11rem]">
      <div class="pointer-events-none absolute -left-24 top-10 h-80 w-80 rounded-full bg-accent/35 blur-[100px]" data-blob></div>
      <div class="pointer-events-none absolute -right-24 top-24 h-80 w-80 rounded-full bg-sky-200/50 blur-[100px]" data-blob></div>
      <div class="relative mx-auto max-w-[1650px] px-6 min-[1580px]:px-0">
        <h1 id="hero-title" class="mx-auto mt-6 max-w-3xl text-[1.9rem] font-normal leading-[1.28] sm:mt-4 sm:text-5xl sm:leading-[1.2] lg:max-w-none">Reventa de entradas segura y legal</h1>
        <p id="hero-sub" class="mt-3 text-lg font-normal sm:mt-7 sm:text-[1.4rem]">Compra y vende entradas</p>

        <form id="search" role="search" class="relative z-30 mx-auto mt-8 w-full max-w-[1000px] text-left sm:mt-10 sm:w-[max(34rem,53vw)]" onsubmit="return false" autocomplete="off">
          <div id="search-box" class="flex h-14 items-center gap-3 rounded-lg bg-white px-4 text-ink transition-shadow sm:h-[clamp(3.4rem,3.7vw,4.4rem)] sm:px-5">
            <svg viewBox="0 0 24 24" class="h-6 w-6 shrink-0 text-ink/35" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"></circle><path d="M21 21l-4.3-4.3"></path></svg>
            <input id="q" type="search" placeholder="Busca eventos, recintos, ciudades o artistas" aria-label="Buscar eventos" class="w-full bg-transparent text-base outline-none placeholder:text-ink/70 sm:text-[clamp(1rem,1.06vw,1.25rem)]" />
          </div>
          <ul id="results" class="absolute inset-x-0 top-full z-30 mt-2 hidden overflow-hidden rounded-xl bg-white p-2 text-ink shadow-2xl ring-1 ring-black/5"></ul>
        </form>
      </div>

      <!-- Tira de butacas (render 3D) -->
      <div id="seats-wrap" class="seats-wrap relative z-0 mt-4 overflow-hidden sm:mt-6">
        <div id="seats" class="seats-img" role="img" aria-label="Filas de butacas de estadio, una de ellas resaltada en naranja"></div>
        <div id="seat-tip" class="pointer-events-none absolute z-10 hidden whitespace-nowrap rounded-xl bg-white px-4 py-2.5 text-left text-sm text-ink shadow-xl lg:block"><p class="font-semibold text-accent">Tu entrada</p><p class="text-xs text-sub">Grada 12 · Fila 4</p></div>
      </div>
    </section>

    <!-- SUGERENCIAS -->
    <section id="sugerencias" class="mx-auto max-w-[1500px] pt-12 sm:pt-16" aria-labelledby="t-sug">
      <div class="flex items-center justify-between px-6 min-[1580px]:px-0">
        <h2 id="t-sug" class="text-2xl font-medium sm:text-3xl" data-reveal>Sugerencias para ti</h2>
        <div class="hidden gap-2 sm:flex"><button class="car-btn" data-car="sug" data-dir="-1" aria-label="Anterior"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button><button class="car-btn" data-car="sug" data-dir="1" aria-label="Siguiente"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button></div>
      </div>
      <div id="sug" class="car no-scrollbar mt-6 flex gap-6 overflow-x-auto px-6 pb-2 min-[1580px]:px-0" tabindex="0" aria-label="Eventos sugeridos">
        {events.map((e, i) => (
          <article class="w-[17.25rem] shrink-0 lg:w-[18.1rem]" data-card>
            <a href={`#/evento/${e.id}`} class="block w-full text-left" aria-label={`Ver ${e.t}`}>
              <div class="card-art aspect-square"><div class="art h-full w-full" style={`background-image:var(--art-${e.id})`}></div></div>
              <p class="mt-3.5 text-sm text-accent">{fecha(e.date)}</p>
              <p class="mt-0.5 truncate text-base font-medium">{extra[e.id].name}</p>
              <p class="truncate text-sm text-sub">{e.v}, {e.c}</p>
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- NO TE LO PUEDES PERDER -->
    <section class="mx-auto max-w-[1500px] pt-12 sm:pt-16" aria-labelledby="t-top">
      <div class="flex items-center justify-between px-6 min-[1580px]:px-0">
        <h2 id="t-top" class="text-2xl font-medium sm:text-3xl" data-reveal>No te lo puedes perder</h2>
        <div class="hidden gap-2 sm:flex"><button class="car-btn" data-car="top" data-dir="-1" aria-label="Anterior"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button><button class="car-btn" data-car="top" data-dir="1" aria-label="Siguiente"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button></div>
      </div>
      <div id="top" class="car no-scrollbar mt-6 flex gap-6 overflow-x-auto px-6 pb-2 min-[1580px]:px-0" tabindex="0" aria-label="Eventos destacados">
        {featured.map((f, i) => (
          <article class="w-[19.3rem] shrink-0 sm:w-[21rem] lg:w-[18.1rem]" data-card>
            <a href={`#/evento/${f.ev.id}`} class="group relative block h-[27rem] w-full overflow-hidden rounded-3xl text-left text-white sm:h-[27rem] lg:h-[18.1rem]" aria-label={`Ver ${f.t}`} data-tiltcard>
              <div class="art absolute inset-[-4%] h-[108%] w-[108%] will-change-transform" data-par style={`background-image:var(--art-${f.ev.id})`}></div>
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/15 to-black/5"></div>
              <div class="absolute inset-x-0 bottom-0 p-5">
                <p class="text-xl font-semibold leading-tight lg:text-lg">{f.t}</p>
                <p class="line-2 mt-1.5 text-sm leading-snug text-white/80 lg:text-xs">{f.s}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- SITIOS POPULARES -->
    <section class="mx-auto max-w-[1500px] pt-12 sm:pt-16" aria-labelledby="t-pop">
      <div class="flex items-center justify-between px-6 min-[1580px]:px-0">
        <h2 id="t-pop" class="text-2xl font-medium sm:text-3xl" data-reveal>Sitios populares</h2>
        <div class="hidden gap-2 sm:flex"><button class="car-btn" data-car="pop" data-dir="-1" aria-label="Anterior"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button><button class="car-btn" data-car="pop" data-dir="1" aria-label="Siguiente"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button></div>
      </div>
      <div id="pop" class="car no-scrollbar mt-6 flex gap-6 overflow-x-auto px-6 pb-2 min-[1580px]:px-0" tabindex="0" aria-label="Sitios populares">
        {sedes.map((s, i) => (
          <article class="w-[17.25rem] shrink-0 lg:w-[18.1rem]" data-card>
            <a href={`#/buscar/${encodeURIComponent(s.c)}`} class="block w-full text-left" aria-label={`Ver eventos en ${s.n}`}>
              <div class="card-art aspect-square"><div class="art h-full w-full" style={`background-image:var(--art-${s.ev.id});background-size:${s.z}%;background-position:${s.p}`}></div></div>
              <p class="mt-3.5 text-base font-medium">{s.n}</p>
              <p class="text-sm text-sub">{s.c}</p>
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- CTA APP -->
    <section class="mx-auto max-w-[1500px] px-5 pt-16 sm:pt-24 min-[1580px]:px-0" aria-labelledby="t-cta">
      <div id="cta" class="grid items-center overflow-hidden rounded-[1.75rem] bg-soft md:grid-cols-2">
        <div class="px-7 pb-2 pt-10 text-center md:px-16 md:pb-14 md:pt-14 md:text-left">
          <h2 id="t-cta" class="text-balance text-[1.9rem] font-semibold leading-[1.15] sm:text-[2.6rem]" data-reveal>Sé el primero en conseguir entradas para tus eventos favoritos.</h2>
          <p class="mx-auto mt-4 max-w-md text-lg font-light text-ink/80 md:mx-0" data-reveal>Descárgate la app y empieza a comprar y vender entradas desde tu teléfono.</p>
          <div class="mt-7 hidden flex-col items-start gap-3 md:flex" data-reveal>
            <a href="#" data-store class="flex h-14 w-48 items-center whitespace-nowrap gap-2.5 rounded-lg bg-black px-4 text-white ring-1 ring-white/20 transition hover:-translate-y-0.5"><svg viewBox="0 0 24 24" class="h-7 w-7" fill="currentColor"><path d="M16.4 12.6c0-2.4 2-3.5 2.1-3.6-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9s-1.9-.9-3.2-.8c-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8s1.9.8 3.2.8c1.3 0 2.1-1.2 2.9-2.3.9-1.3 1.3-2.6 1.3-2.7-.1 0-2.4-.9-2.4-3.8zM14 5.4c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.6 2.8-1.4z"/></svg><span class="text-left"><span class="block text-[10px] leading-none">Download on the</span><span class="text-xl font-medium leading-tight">App Store</span></span></a>
            <a href="#" data-store class="flex h-14 w-48 items-center whitespace-nowrap gap-2.5 rounded-lg bg-black px-4 text-white ring-1 ring-white/20 transition hover:-translate-y-0.5"><svg viewBox="0 0 24 24" class="h-7 w-7"><path fill="#34a853" d="M3.6 2.3 13.4 12 3.6 21.7a1.5 1.5 0 01-.6-1.2V3.5c0-.5.2-.9.6-1.2z"/><path fill="#fbbc04" d="m17 8.4-3.6 3.6 3.6 3.6 4-2.3c1.2-.7 1.2-1.8 0-2.5L17 8.4z"/><path fill="#ea4335" d="M3.6 21.7 13.4 12 17 15.6 5.7 22c-.8.4-1.6.2-2.1-.3z"/><path fill="#4285f4" d="M3.6 2.3c.5-.5 1.3-.7 2.1-.3L17 8.4 13.4 12 3.6 2.3z"/></svg><span class="text-left"><span class="block text-[10px] leading-none">GET IT ON</span><span class="text-xl font-medium leading-tight">Google Play</span></span></a>
          </div>
        </div>
        <div class="relative mx-auto mt-8 h-[17rem] w-full max-w-[24rem] overflow-hidden md:mt-10 md:h-[26rem]" aria-hidden="true">
          <div class="phone absolute inset-x-8 bottom-0 top-6 text-center text-white md:inset-x-12 md:top-10">
            <div class="mx-auto mt-2 h-6 w-24 rounded-full bg-black"></div>
            <p id="lock-date" class="mt-5 text-[11px] font-medium text-white/85">domingo, 10 de marzo</p>
            <p id="lock-time" class="text-[2.6rem] font-semibold leading-none tracking-tight md:text-5xl">1:47</p>
            <div id="notif" class="notif absolute inset-x-2.5 top-[8.6rem] rounded-2xl p-3 text-left text-ink md:top-[10rem]">
              <div class="flex items-center gap-2 text-[9px] font-medium uppercase tracking-wider text-ink/55"><span class="grid h-4 w-4 place-items-center rounded-[5px] bg-accent text-[8px] text-white">🎟</span>{brand.name}<span class="ml-auto normal-case tracking-normal">ahora</span></div>
              <p id="n-t" class="mt-1.5 text-[12px] font-semibold leading-snug">¡Una nueva entrada para Karol Vega! 🎟️</p>
              <p id="n-b" class="mt-0.5 text-[11px] leading-snug text-ink/80">Alguien está vendiendo su entrada por 120€, consíguela antes de que se agote.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- POR QUÉ -->
    <section id="como" class="mx-auto max-w-[1500px] px-5 pt-16 sm:pt-24 min-[1580px]:px-0" aria-labelledby="t-why">
      <h2 id="t-why" class="text-2xl font-medium sm:text-3xl" data-reveal>¿Por qué {brand.name}?</h2>
      <div class="mt-7 grid gap-5 md:grid-cols-3">
        <!-- 1 · Reventa segura -->
        <article class="why rounded-2xl bg-[#f8f8f9] px-6 pb-9 pt-7 text-center md:px-8" data-why="lock">
          <h3 class="text-[1.55rem] font-normal md:text-[1.7rem]">Reventa segura</h3>
          <svg viewBox="0 0 320 240" class="mx-auto mt-3 h-auto w-full max-w-[22rem] overflow-visible" role="img" aria-label="Un candado protege tus entradas">
            <defs>
              <radialGradient id="orb" cx=".5" cy=".4" r=".7"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#ececf5"/></radialGradient>
              <linearGradient id="lk" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff9d57"/><stop offset="1" stop-color="#e8590c"/></linearGradient>
              <filter id="sh" x="-30%" y="-30%" width="160%" height="170%"><feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="#3a2a1a" flood-opacity=".16"/></filter>
            </defs>
            <g class="rings" fill="none" stroke="#d9d9e4">
              <circle class="ring-c" cx="160" cy="120" r="152" stroke-opacity=".45" stroke-width="1.4"/>
              <circle class="ring-c" cx="160" cy="120" r="112" stroke-opacity=".6" stroke-width="1.4"/>
              <circle class="ring-c" cx="160" cy="120" r="78" stroke-opacity=".8" stroke-width="1.4" fill="#f3f3f8"/>
            </g>
            <g class="sheet-g" data-s="a" transform="translate(66 128) rotate(-14)" filter="url(#sh)">
              <rect width="66" height="84" rx="7" fill="#fff"/><rect x="14" y="26" width="38" height="5" rx="2.5" fill="#e7e7ee"/><rect x="14" y="38" width="30" height="5" rx="2.5" fill="#e7e7ee"/><rect x="14" y="50" width="36" height="5" rx="2.5" fill="#e7e7ee"/>
              <g transform="translate(-9 36) rotate(-8)"><rect width="26" height="13" rx="3.5" fill="#e8590c"/><text x="13" y="9.4" text-anchor="middle" font-family="Poppins,sans-serif" font-size="7.5" font-weight="700" fill="#fff">PDF</text></g>
            </g>
            <g class="sheet-g" data-s="b" transform="translate(188 52) rotate(14)" filter="url(#sh)">
              <rect width="74" height="94" rx="7" fill="#fff"/><rect x="16" y="16" width="26" height="5" rx="2.5" fill="#e7e7ee"/><rect x="16" y="44" width="44" height="5" rx="2.5" fill="#e7e7ee"/><rect x="16" y="56" width="36" height="5" rx="2.5" fill="#e7e7ee"/><rect x="16" y="68" width="42" height="5" rx="2.5" fill="#e7e7ee"/>
              <g transform="translate(-10 18) rotate(-8)"><rect width="26" height="13" rx="3.5" fill="#e8590c"/><text x="13" y="9.4" text-anchor="middle" font-family="Poppins,sans-serif" font-size="7.5" font-weight="700" fill="#fff">PDF</text></g>
            </g>
            <g id="lock-orb" filter="url(#sh)"><circle cx="160" cy="120" r="46" fill="url(#orb)"/><circle cx="160" cy="120" r="46" fill="none" stroke="#fff" stroke-width="2"/></g>
            <g id="lock-g" transform="translate(160 122)">
              <path id="shackle" d="M-10 -6v-7a10 10 0 0120 0v7" fill="none" stroke="#f2762a" stroke-width="5.5" stroke-linecap="round"/>
              <rect x="-17" y="-6" width="34" height="28" rx="8" fill="url(#lk)"/>
              <rect x="-2.2" y="3" width="4.4" height="10" rx="2.2" fill="#ffd9bd"/>
            </g>
          </svg>
          <p class="mt-3 text-[1.02rem] font-light leading-relaxed text-sub md:text-[1.2rem]">En {brand.name} aplicamos un riguroso protocolo antifraude para garantizar que las entradas sean seguras.</p>
        </article>

        <!-- 2 · Garantía de entrega -->
        <article class="why rounded-2xl bg-[#f8f8f9] px-6 pb-9 pt-7 text-center md:px-8" data-why="pdf">
          <h3 class="text-[1.55rem] font-normal md:text-[1.7rem]">Garantía de entrega</h3>
          <svg viewBox="0 0 320 240" class="mx-auto mt-3 h-auto w-full max-w-[22rem] overflow-visible" role="img" aria-label="Un PDF cae en una bandeja">
            <defs>
              <linearGradient id="pf" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e8590c"/><stop offset="1" stop-color="#ffa863"/></linearGradient>
              <linearGradient id="tr" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fdfdfe"/><stop offset="1" stop-color="#e8e8ee"/></linearGradient>
              <filter id="sh2" x="-30%" y="-30%" width="160%" height="170%"><feDropShadow dx="0" dy="10" stdDeviation="9" flood-color="#2a2a60" flood-opacity=".13"/></filter>
            </defs>
            <g filter="url(#sh2)"><path d="M36 168 L284 168 L270 214 Q268 220 260 220 L60 220 Q52 220 50 214Z" fill="url(#tr)"/></g>
            <path d="M32 164 L58 142 L262 142 L288 164 L282 172 L38 172Z" fill="#f4f4f8"/>
            <g id="pdf-wrap" clip-path="url(#tray-clip)">
              <g id="pdf-file">
                <path d="M62 62 Q62 52 72 52 H196 L252 108 V170 H62Z" fill="url(#pf)"/>
                <path d="M196 52 L252 108 H206 Q196 108 196 98Z" fill="#c94a08" opacity=".0"/>
                <text x="82" y="94" font-family="Poppins,sans-serif" font-weight="600" font-size="26" fill="#fff">PDF</text>
                <rect x="82" y="104" width="52" height="8" rx="4" fill="#fff" opacity=".4"/>
              </g>
            </g>
            <clipPath id="tray-clip"><rect x="0" y="-200" width="320" height="372"/></clipPath>
            <path d="M44 166 H276 L284 176 H36Z" fill="url(#tr)"/>
            <path d="M44 166 H276" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <p class="mt-3 text-[1.02rem] font-light leading-relaxed text-sub md:text-[1.2rem]">Al contrario de otras plataformas, cuando compras entradas en {brand.name}, la entrega de las entradas está garantizada.</p>
        </article>

        <!-- 3 · Pago asegurado -->
        <article class="why rounded-2xl bg-[#f8f8f9] px-6 pb-9 pt-7 text-center md:px-8" data-why="pay">
          <h3 class="text-[1.55rem] font-normal md:text-[1.7rem]">Pago asegurado</h3>
          <div class="relative mx-auto mt-3 grid h-[15rem] w-full max-w-[22rem] place-items-center overflow-hidden">
            <div id="receipt" class="receipt w-[88%] px-6 pt-7 text-left">
              <div class="border-t border-dashed border-black/12 pt-5"><p class="text-[0.95rem]">Tickets</p><div class="mt-3 flex items-center justify-between text-sm"><span class="text-black/40">2 x Tickets</span><span class="font-medium text-emerald-600" id="amt">+ 120,00 €</span></div></div>
              <div class="mt-5 border-t border-dashed border-black/12 pb-9"></div>
            </div>
            <span id="paid" class="absolute bottom-4 right-[8%] grid h-10 w-10 place-items-center rounded-full bg-emerald-500 text-white shadow-lg"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"/></svg></span>
          </div>
          <p class="mt-3 text-[1.02rem] font-light leading-relaxed text-sub md:text-[1.2rem]">Adiós a las estafas y los fraudes en la reventa, recibe tu dinero de forma automática tras el evento.</p>
        </article>
      </div>
    </section>

    <!-- OPINIONES -->
    <section class="mt-16 bg-soft py-16 sm:mt-24 sm:py-24" aria-labelledby="t-rev">
      <h2 id="t-rev" class="mx-auto max-w-3xl px-5 text-center text-[2rem] font-normal leading-tight sm:text-4xl" data-reveal>Lo que dicen nuestros usuarios</h2>
      <div class="mx-auto mt-10 max-w-[1500px]">
        <div id="rev" class="no-scrollbar flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-4 lg:grid lg:grid-cols-3 lg:overflow-visible min-[1580px]:px-0 lg:pb-0">
          {reviews.map((r, i) => (
            <figure class="rev relative flex min-h-[22rem] w-[86vw] shrink-0 snap-center flex-col rounded-3xl bg-white p-7 shadow-[0_14px_40px_-18px_rgba(0,0,0,0.18)] sm:w-[28rem] lg:min-h-[19rem] lg:w-auto" data-i={i}>
              <svg viewBox="0 0 48 36" class="h-9 w-12 text-black/10" fill="currentColor" aria-hidden="true"><path d="M0 36V20C0 8 6 1.5 17 0v7c-5 1-8 4-8 9h8v20H0zm27 0V20C27 8 33 1.5 44 0v7c-5 1-8 4-8 9h8v20H27z"/></svg>
              <blockquote class="mt-4 flex-1 text-[1.02rem] font-light leading-relaxed text-ink/80">{r.t}</blockquote>
              <figcaption class="mt-6 flex items-center gap-4"><span class="grid h-14 w-14 shrink-0 place-items-center overflow-hidden rounded-full bg-[#c9c9cf]"><svg viewBox="0 0 48 48" class="h-14 w-14" fill="#fff"><circle cx="24" cy="19" r="8"/><path d="M6 48c0-11 8-17 18-17s18 6 18 17z"/></svg></span><span class="text-base">{r.n}</span></figcaption>
            </figure>
          ))}
        </div>
        <div class="mt-5 flex items-center justify-center gap-2 lg:hidden" id="dots" aria-hidden="true">
          {reviews.map((_, i) => (<i data-dot={i} class="h-2 rounded-full bg-black/20 transition-all" style={i === 0 ? "width:1.75rem;background:#e8590c" : "width:0.5rem"}></i>))}
        </div>
      </div>
    </section>
  </main>
  <main id="v-event" class="view hidden" data-view="event"></main>
  <main id="v-search" class="view hidden" data-view="search"></main>
  <Sell />
  <main id="v-tickets" class="view hidden" data-view="tickets"></main>
  <main id="v-listings" class="view hidden" data-view="listings"></main>
  <main id="v-legal" class="view hidden" data-view="legal"></main>
  <main id="v-help" class="view hidden" data-view="help"></main>
  <main id="v-profile" class="view hidden" data-view="profile"></main>
  <main id="v-pick" class="view hidden" data-view="pick"></main>
  <main id="v-wizard" class="view hidden" data-view="wizard"></main>
  </div>

  <!-- FOOTER -->
  <footer id="footer" class="border-t border-line px-6 pb-8 pt-12 min-[1580px]:px-0">
    <div class="mx-auto grid max-w-[1500px] gap-10 md:grid-cols-4">
      <div>
        <p class="text-base">Descarga la App</p>
        <div class="mt-4 flex flex-col items-start gap-3">
          <a href="#" data-store class="flex h-14 w-48 items-center whitespace-nowrap gap-2.5 rounded-lg bg-black px-4 text-white ring-1 ring-white/20 transition hover:-translate-y-0.5"><svg viewBox="0 0 24 24" class="h-7 w-7" fill="currentColor"><path d="M16.4 12.6c0-2.4 2-3.5 2.1-3.6-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9s-1.9-.9-3.2-.8c-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8s1.9.8 3.2.8c1.3 0 2.1-1.2 2.9-2.3.9-1.3 1.3-2.6 1.3-2.7-.1 0-2.4-.9-2.4-3.8zM14 5.4c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.6 2.8-1.4z"/></svg><span class="text-left"><span class="block text-[10px] leading-none">Download on the</span><span class="text-xl font-medium leading-tight">App Store</span></span></a>
          <a href="#" data-store class="flex h-14 w-48 items-center whitespace-nowrap gap-2.5 rounded-lg bg-black px-4 text-white ring-1 ring-white/20 transition hover:-translate-y-0.5"><svg viewBox="0 0 24 24" class="h-7 w-7"><path fill="#34a853" d="M3.6 2.3 13.4 12 3.6 21.7a1.5 1.5 0 01-.6-1.2V3.5c0-.5.2-.9.6-1.2z"/><path fill="#fbbc04" d="m17 8.4-3.6 3.6 3.6 3.6 4-2.3c1.2-.7 1.2-1.8 0-2.5L17 8.4z"/><path fill="#ea4335" d="M3.6 21.7 13.4 12 17 15.6 5.7 22c-.8.4-1.6.2-2.1-.3z"/><path fill="#4285f4" d="M3.6 2.3c.5-.5 1.3-.7 2.1-.3L17 8.4 13.4 12 3.6 2.3z"/></svg><span class="text-left"><span class="block text-[10px] leading-none">GET IT ON</span><span class="text-xl font-medium leading-tight">Google Play</span></span></a>
        </div>
      </div>
      <nav aria-label={brand.name}><p class="text-base">{brand.name}</p><ul class="mt-4 space-y-3 text-base font-light text-sub"><li><a class="hover:text-accent" href="#/">Inicio</a></li><li><a class="hover:text-accent" href="#" data-sell>Vender entrada</a></li><li><a class="hover:text-accent" href="#/vender">Cómo funciona</a></li><li><a class="hover:text-accent" href="#" data-soon>Blog</a></li></ul></nav>
      <nav aria-label="Asistencia"><p class="text-base">Asistencia</p><ul class="mt-4 space-y-3 text-base font-light text-sub"><li><a class="hover:text-accent" href="#/ayuda">Centro de ayuda</a></li><li><a class="hover:text-accent" href="#/ayuda/vender">Cómo vender una entrada</a></li><li><a class="hover:text-accent" href="#/ayuda/seguridad">Seguridad de la plataforma</a></li></ul></nav>
      <nav aria-label="Legal"><p class="text-base">Legal</p><ul class="mt-4 space-y-3 text-base font-light text-sub"><li><a class="hover:text-accent" href="#/legal/privacidad">Política de privacidad</a></li><li><a class="hover:text-accent" href="#/legal/terminos">Condiciones de uso</a></li><li><a class="hover:text-accent" href="#/legal/cookies">Política de cookies</a></li><li><a class="hover:text-accent" href="#/legal/aviso-legal">Aviso legal</a></li></ul></nav>
    </div>
    <div class="mx-auto mt-12 max-w-[1500px] border-t border-line pt-8">
      <ul class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm font-light text-sub md:grid-cols-3">
        {cities.map((c) => (<li><a class="hover:text-accent" href={`#/buscar/${encodeURIComponent(c)}`}>Reventa de entradas {c}</a></li>))}
        <li><a class="hover:text-accent" href="#/vender">Reventa fan to fan de entradas</a></li>
        <li><a class="hover:text-accent" href="#/buscar/musica">Entradas de conciertos</a></li>
        <li><a class="hover:text-accent" href="#/buscar/festival">Entradas de festivales</a></li>
      </ul>
    </div>
    <div class="mx-auto mt-10 grid max-w-[1500px] items-center gap-4 text-sm text-sub md:grid-cols-3">
      <label class="order-2 flex items-center gap-2 md:order-1"><span class="sr-only">Moneda</span><select class="rounded-md border border-line bg-white px-2 py-1.5 text-sm outline-none" aria-label="Moneda"><option>Euro</option><option>Dólar</option><option>Libra</option></select></label>
      <p class="order-1 text-center md:order-2">© {new Date().getFullYear()} {brand.name}. All rights reserved.</p>
      <div class="order-3 flex justify-start gap-4 md:justify-end" id="langs"><button class="font-medium text-ink" aria-current="true">Español</button><button data-soon>English</button><button data-soon>Français</button><button data-soon>Português</button></div>
    </div>
  </footer>

  <!-- Cookies -->
  <aside id="cookies" class="fixed bottom-4 left-4 z-[150] hidden w-[calc(100vw-2rem)] max-w-[37.5rem] rounded-xl bg-white p-5 shadow-[0_20px_60px_-14px_rgba(0,0,0,0.35)] sm:bottom-10 sm:left-10" role="dialog" aria-label="Cookies">
    <p class="text-base">Cookies</p>
    <p class="mt-4 text-[1.02rem] font-light leading-relaxed text-ink/80">{brand.name} utiliza cookies de terceros para ofrecerte la mejor experiencia posible. Puedes leer más en nuestra <a href="#/legal/cookies" class="underline underline-offset-2">política de cookies</a>.</p>
    <div class="mt-5 flex items-center justify-between gap-3"><button id="ck-all" class="rounded-xl bg-black px-6 py-4 text-base text-white transition hover:bg-ink/80">Aceptar</button><button id="ck-min" class="text-base font-light text-sub transition hover:text-ink">Aceptar solo las necesarias</button></div>
  </aside>

  <!-- Buscador (paleta) -->
  <div id="sp" class="overlay !items-start !pt-[10vh]" aria-hidden="true"><div id="sp-box" class="sheet !max-h-[80svh] !rounded-3xl p-3 sm:!max-w-2xl" role="dialog" aria-modal="true" aria-label="Buscar"><div class="flex items-center gap-3 rounded-2xl bg-soft px-4 py-3"><svg viewBox="0 0 24 24" class="h-6 w-6 shrink-0 text-ink/50" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.3-4.3"/></svg><input id="sp-q" type="search" autocomplete="off" placeholder="Busca eventos, recintos, ciudades o artistas" aria-label="Buscar" class="w-full bg-transparent text-lg outline-none" /><kbd class="hidden rounded border border-line px-1.5 text-xs text-sub sm:block">Esc</kbd></div><ul id="sp-list" class="mt-2 space-y-1"></ul></div></div>

  <!-- Hoja modal (evento / acceso / vender / entradas) -->
  <div id="ov" class="overlay" aria-hidden="true"><div id="sheet" class="sheet" role="dialog" aria-modal="true" tabindex="-1"></div></div>
