---
import Seo from "../layouts/Seo.astro";
import { landings, eventsIn, eventsCat, extra, fechaLarga, graph, crumbs, organization, homeFaq, faqLd, abs } from "../seo";
export const getStaticPaths = () => landings.map((l) => ({ params: { landing: l.slug }, props: { l } }));
const { l } = Astro.props;
const list = l.kind === "city" ? eventsIn(l.name) : eventsCat(l.cat!.cats);
const h1 = l.kind === "city" ? `Reventa de entradas en ${l.name}` : l.cat!.h;
const description = l.kind === "city"
  ? `Compra y vende entradas para conciertos, festivales, clubs y deporte en ${l.name}. Pago protegido, entrega al instante y vendedores verificados en Handticket.`
  : `Compra y vende ${l.cat!.n} con entradas verificadas, pago protegido y entrega al instante. Reventa segura y legal en Handticket.`;
const url = `/${l.slug}/`;
const itemList = { "@type": "ItemList", itemListElement: list.map((e, i) => ({ "@type": "ListItem", position: i + 1, url: abs(`/evento/${e.id}/`), name: extra[e.id].name })) };
---
<Seo title={`${h1} | Handticket`} description={description} canonical={url} jsonld={graph(organization(), crumbs([["Inicio", "/"], [h1, url]]), itemList, faqLd(homeFaq))}>
  <h1 class="mt-6 text-[2.2rem] font-semibold leading-tight sm:text-[3rem]">{h1}</h1>
  <p class="mt-3 max-w-3xl text-lg text-ink/80">{description}</p>
  <h2 class="mt-10 text-2xl font-semibold">Próximos eventos{l.kind === "city" ? ` en ${l.name}` : ""}</h2>
  {list.length ? <div class="mt-5 grid gap-6 sm:grid-cols-2 md:grid-cols-3">{list.map((e) => <a href={`/evento/${e.id}/`} class="block"><img src={`/og/${e.id}.webp`} alt={`Cartel de ${extra[e.id].name}`} loading="lazy" width="300" height="300" class="aspect-square w-full rounded-2xl object-cover" /><p class="mt-3 text-sm text-accent">{fechaLarga(e.date)}</p><p class="font-medium">{extra[e.id].name}</p><p class="text-sm text-sub">{e.v}, {e.c}</p></a>)}</div> : <p class="mt-4 text-ink/80">Todavía no hay eventos publicados aquí. <a class="text-accent underline" href="/#/vender/evento">Publica la primera entrada</a> o <a class="text-accent underline" href="/">explora todos los eventos</a>.</p>}
  <h2 class="mt-14 text-2xl font-semibold">Preguntas frecuentes</h2>
  <div class="mt-4 space-y-5">{homeFaq.map((f) => <div><h3 class="font-medium">{f.q}</h3><p class="mt-1 text-ink/80">{f.a}</p></div>)}</div>
</Seo>
