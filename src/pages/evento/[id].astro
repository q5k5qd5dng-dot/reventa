---
import Seo from "../../layouts/Seo.astro";
import { slugify, events, extra, fechaLarga, abs, eventLd, graph, crumbs, organization } from "../../seo";
export const getStaticPaths = () => events.map((e) => ({ params: { id: e.id }, props: { e } }));
const { e } = Astro.props; const x = extra[e.id];
const from = Math.min(...x.tickets.filter((t) => t.list).map((t) => t.from));
const short = (t: string, n: number) => (t.length <= n ? t : t.slice(0, n - 1).replace(/\s\S*$/, "") + "…");
const title = `Entradas ${short(x.name, 34)} en ${e.c} | Handticket`;
const description = short(`Entradas para ${x.name} en ${e.v} (${e.c}), ${fechaLarga(e.date)}. Desde ${from} €, pago protegido y entrega al instante.`, 158);
const faq = [
  { q: `¿Cuándo y dónde es ${x.name}?`, a: `${x.name} se celebra el ${fechaLarga(e.date)} en ${e.v}, ${x.address}.` },
  { q: `¿Cuánto cuestan las entradas de ${x.name}?`, a: `Las entradas están desde ${from} € en Handticket. El precio final incluye gastos de gestión y se muestra antes de pagar.` },
  { q: "¿Es seguro comprar aquí?", a: "Sí. El pago queda retenido hasta que se celebra el evento y cada entrada pasa por un protocolo antifraude. Si algo falla, devolvemos el dinero." },
];
const ld = graph(organization(), eventLd(e), crumbs([["Inicio", "/"], [x.name, `/evento/${e.id}/`]]), { "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) });
---
<Seo title={title} description={description} canonical={`/evento/${e.id}/`} image={`/og/${e.id}.webp`} jsonld={ld} appHref={`/#/evento/${e.id}`}>
  <nav class="text-sm text-sub" aria-label="Ruta"><a href="/" class="hover:text-accent">Inicio</a> › <a href={`/reventa-entradas-${slugify(e.c)}/`} class="hover:text-accent">{e.c}</a> › {x.name}</nav>
  <div class="mt-6 grid gap-8 md:grid-cols-[18rem_1fr]">
    <img src={`/og/${e.id}.webp`} alt={`Cartel de ${x.name}`} width="288" height="288" class="aspect-square w-full rounded-2xl object-cover" />
    <div>
      <p class="text-accent">{fechaLarga(e.date)}</p>
      <h1 class="mt-1 text-[2rem] font-semibold leading-tight sm:text-[2.8rem]">Entradas {x.name}</h1>
      <p class="mt-2 text-sub">{e.v} · {e.c}</p>
      <p class="mt-5 text-lg text-ink/80">{e.desc}</p>
      <a href={`/#/evento/${e.id}`} class="mt-6 inline-block rounded-xl bg-accent px-6 py-3.5 font-medium text-white">Ver entradas desde {from} €</a>
    </div>
  </div>
  <h2 class="mt-14 text-2xl font-semibold">Tipos de entrada</h2>
  <ul class="mt-4 divide-y divide-line rounded-2xl border border-line">{x.tickets.map((t) => <li class="flex items-center justify-between gap-4 px-5 py-4"><div><p class="font-medium">{t.n}</p><p class="text-sm text-sub">{t.sub}</p></div><p class="text-right"><span class="font-semibold">desde {t.from} €</span><br /><span class="text-sm text-sub">{t.list ? `${t.list} anuncio${t.list > 1 ? "s" : ""}` : "Sin anuncios"}</span></p></li>)}</ul>
  <h2 class="mt-14 text-2xl font-semibold">Información del evento</h2>
  <dl class="mt-4 grid gap-3 sm:grid-cols-2 text-ink/85"><div><dt class="text-sm text-sub">Recinto</dt><dd>{e.v}, {x.address}</dd></div><div><dt class="text-sm text-sub">Artistas y participantes</dt><dd>{x.people.join(", ")}</dd></div></dl>
  <h2 class="mt-14 text-2xl font-semibold">Preguntas frecuentes</h2>
  <div class="mt-4 space-y-5">{faq.map((f) => <div><h3 class="font-medium">{f.q}</h3><p class="mt-1 text-ink/80">{f.a}</p></div>)}</div>
</Seo>
