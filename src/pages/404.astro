---
import Seo from "../layouts/Seo.astro";
---
<Seo title="Página no encontrada | Handticket" description="No hemos encontrado esta página. Vuelve al inicio para buscar tu evento." canonical="/404/">
  <meta slot="head" name="robots" content="noindex" />
  <h1 class="mt-16 text-[2.4rem] font-semibold sm:text-[3.4rem]">Esta página no existe</h1>
  <p class="mt-4 text-lg text-ink/80">Puede que el enlace haya cambiado. Busca tu evento desde el inicio.</p>
  <a href="/" class="mt-8 inline-block rounded-xl bg-ink px-6 py-3.5 font-medium text-white">Ir al inicio</a>
</Seo>
