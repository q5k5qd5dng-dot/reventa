---
import "../styles/global.css";
const { title, description, bodyClass = "" } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@1,600&family=Bebas+Neue&family=Cinzel:wght@600&family=Pacifico&family=Syne:wght@700&family=Oswald:wght@500&family=Archivo+Black&display=swap" rel="stylesheet" />
  </head>
  <body class={bodyClass}>
    <slot />
    <script>
      function fit() {
        document.querySelectorAll("[data-fit]").forEach((w) => {
          const el = w as HTMLElement;
          const d = Number(el.dataset.fit);
          const vis = Number(el.dataset.vis || 1);
          const s = el.parentElement!.clientWidth / (d * vis);
          el.style.width = d + "px";
          el.style.transform = `scale(${s})`;
          el.style.transformOrigin = "top left";
          el.style.marginBottom = -(el.offsetHeight * (1 - s)) + "px";
        });
      }
      fit();
      addEventListener("resize", fit);
      document.fonts?.ready.then(fit);

      // Pestañas pre / durante / post
      document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
        const btns = root.querySelectorAll<HTMLElement>("[data-tab]");
        const panes = root.querySelectorAll<HTMLElement>("[data-pane]");
        btns.forEach((b) => b.addEventListener("click", () => {
          const k = b.dataset.tab;
          btns.forEach((x) => x.toggleAttribute("data-on", x === b));
          panes.forEach((p) => (p.hidden = p.dataset.pane !== k));
        }));
      });

      // Tarjetas de industria que se expanden
      document.querySelectorAll<HTMLElement>("[data-ind]").forEach((row) => {
        const cards = row.querySelectorAll<HTMLElement>(".ind");
        cards.forEach((c) => ["mouseenter", "focus", "click"].forEach((ev) => c.addEventListener(ev, () => {
          cards.forEach((x) => x.toggleAttribute("data-on", x === c));
        })));
      });

      const io = new IntersectionObserver(
        (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); } }),
        { threshold: 0.12 }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
