---
import "../styles/global.css";
const { title, description, bodyClass = "" } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@1,600&family=Bebas+Neue&family=Cinzel:wght@600&family=Pacifico&family=Syne:wght@700&family=Oswald:wght@500&family=Archivo+Black&display=swap" rel="stylesheet" />
  </head>
  <body class={bodyClass}>
    <slot />
    <script>
      function fit() {
        document.querySelectorAll("[data-fit]").forEach((w) => {
          const el = w as HTMLElement;
          const d = Number(el.dataset.fit);
          const vis = Number(el.dataset.vis || 1);
          const s = el.parentElement!.clientWidth / (d * vis);
          el.style.width = d + "px";
          el.style.transform = `scale(${s})`;
          el.style.transformOrigin = "top left";
          el.style.marginBottom = -(el.offsetHeight * (1 - s)) + "px";
        });
      }
      fit();
      addEventListener("resize", fit);
      document.fonts?.ready.then(fit);

      // Pestañas pre / durante / post
      document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
        const btns = root.querySelectorAll<HTMLElement>("[data-tab]");
        const panes = root.querySelectorAll<HTMLElement>("[data-pane]");
        btns.forEach((b) => b.addEventListener("click", () => {
          const k = b.dataset.tab;
          btns.forEach((x) => x.toggleAttribute("data-on", x === b));
          panes.forEach((p) => (p.hidden = p.dataset.pane !== k));
        }));
      });

      // Tarjetas de industria que se expanden
      document.querySelectorAll<HTMLElement>("[data-ind]").forEach((row) => {
        const cards = row.querySelectorAll<HTMLElement>(".ind");
        cards.forEach((c) => ["mouseenter", "focus", "click"].forEach((ev) => c.addEventListener(ev, () => {
          cards.forEach((x) => x.toggleAttribute("data-on", x === c));
        })));
      });

      // Partículas del hero (público + luces)
      const cv = document.getElementById("hero-fx") as HTMLCanvasElement | null;
      if (cv && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const ctx = cv.getContext("2d")!;
        const dpr = Math.min(devicePixelRatio || 1, 2);
        let w = 0, h = 0, on = true;
        const cols = ["255,90,110", "255,255,255", "130,150,255", "255,170,90"];
        const ps = Array.from({ length: 120 }, () => ({ x: Math.random(), y: Math.random(), r: Math.random() * 2 + 0.4, vx: (Math.random() - 0.5) * 0.00004, vy: -(Math.random() * 0.00006 + 0.00002), c: cols[Math.floor(Math.random() * cols.length)], a: Math.random() * 0.6 + 0.15, t: Math.random() * 6 }));
        const bk = Array.from({ length: 12 }, () => ({ x: Math.random(), y: Math.random() * 0.8, r: 14 + Math.random() * 34, c: cols[Math.floor(Math.random() * 3)], a: 0.05 + Math.random() * 0.08, vx: (Math.random() - 0.5) * 0.00003 }));
        const size = () => { const r = cv.getBoundingClientRect(); w = r.width; h = r.height; cv.width = w * dpr; cv.height = h * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); };
        size();
        addEventListener("resize", size);
        new IntersectionObserver((e) => (on = e[0].isIntersecting)).observe(cv);
        let last = performance.now();
        const tick = (now: number) => {
          const dt = Math.min(now - last, 64);
          last = now;
          if (on) {
            ctx.clearRect(0, 0, w, h);
            for (const b of bk) {
              b.x += b.vx * dt; if (b.x < -0.05) b.x = 1.05; if (b.x > 1.05) b.x = -0.05;
              const g = ctx.createRadialGradient(b.x * w, b.y * h, 0, b.x * w, b.y * h, b.r);
              g.addColorStop(0, `rgba(${b.c},${b.a})`); g.addColorStop(1, `rgba(${b.c},0)`);
              ctx.fillStyle = g; ctx.beginPath(); ctx.arc(b.x * w, b.y * h, b.r, 0, 6.283); ctx.fill();
            }
            for (const p of ps) {
              p.x += p.vx * dt; p.y += p.vy * dt; p.t += dt * 0.002;
              if (p.y < -0.02) { p.y = 1.02; p.x = Math.random(); }
              if (p.x < 0) p.x = 1; if (p.x > 1) p.x = 0;
              ctx.fillStyle = `rgba(${p.c},${p.a * (0.6 + 0.4 * Math.sin(p.t))})`;
              ctx.beginPath(); ctx.arc(p.x * w, p.y * h, p.r, 0, 6.283); ctx.fill();
            }
          }
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      // Aparición escalonada entre hermanos
      const seen = new Map<Element, number>();
      document.querySelectorAll<HTMLElement>(".reveal").forEach((el) => {
        const par = el.parentElement!;
        const n = seen.get(par) ?? 0;
        seen.set(par, n + 1);
        el.style.transitionDelay = Math.min(n, 4) * 90 + "ms";
      });

      const io = new IntersectionObserver(
        (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); } }),
        { threshold: 0.12 }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
