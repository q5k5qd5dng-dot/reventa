---
import "../styles/replica.css";
import { brand } from "../brand";
const { title = `${brand.name} · Reventa de entradas segura y legal`, description = "Compra y vende entradas de conciertos, festivales y deportes con pago protegido, entrega garantizada y vendedores verificados." } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#3f7bf0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <canvas id="confetti" class="pointer-events-none fixed inset-0 z-[400] h-full w-full" aria-hidden="true"></canvas>
    <div id="toasts" aria-live="polite"></div>
    <script>
      import "../scripts/replica";
    </script>
  </body>
</html>
